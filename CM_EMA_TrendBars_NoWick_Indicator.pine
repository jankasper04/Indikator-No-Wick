// Combined Indicator: CM_EMA Trend Bars + No Wick Candlestick Identifier
// Based on original CM_EMA Trend Bars by ChrisMoody (11/1/2014)

//@version=5
indicator(title="CM_EMA TrendBars + No Wick Identifier", shorttitle="CM_EMA TrendBars NoWick", overlay=true)

// ============================================================================
// INPUTS
// ============================================================================

// EMA Settings
ema1 = input.int(34, minval=1, maxval=300, title="EMA Period")
shema = input.bool(true, title="Show EMA Line?")

// No Wick Settings
showNoWickSignals = input.bool(true, title="Show No Wick Signals?")
showCompensationLines = input.bool(true, title="Show Compensation Lines?")
showCompensationLabels = input.bool(true, title="Show Compensation Labels?")
compensationColor = input.color(color.rgb(255, 174, 53, 5), title="Compensation Line/Label Color")
barsToRightMultiplier = input.int(10, minval=1, maxval=100, title="Line Length (bars)")

// ============================================================================
// EMA TREND BARS LOGIC
// ============================================================================

// Calculate EMA
usedEma = ta.ema(close, ema1)

// Determine trend direction based on HLC3
emaUpColor = hlc3 >= usedEma
emaDownColor = hlc3 < usedEma

// Set bar colors based on trend
barcolor(emaUpColor ? color.lime : emaDownColor ? color.red : na)

// Plot EMA line with dynamic color
emaColor = hlc3 >= usedEma ? color.lime : hlc3 < usedEma ? color.red : color.white
plot(shema ? usedEma : na, title="EMA", style=plot.style_line, linewidth=3, color=emaColor)

// ============================================================================
// NO WICK CANDLESTICK IDENTIFIER LOGIC
// ============================================================================

// Check for bullish candles with no bottom wick (open equals low)
bullishNoBottomWick = open == low and close > open

// Check for bearish candles with no top wick (open equals high)
bearishNoTopWick = open == high and close < open

// Plot triangles for no wick candles
plotshape(series=showNoWickSignals and bullishNoBottomWick, location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small, title="Bullish No Bottom Wick")
plotshape(series=showNoWickSignals and bearishNoTopWick, location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small, title="Bearish No Top Wick")

// Calculate bars to right for line extension
barsToRight = barsToRightMultiplier

// Draw compensation lines and labels for no wick candles
if showCompensationLines and (bullishNoBottomWick or bearishNoTopWick)
    line.new(x1=bar_index, y1=open, x2=bar_index + barsToRight, y2=open, color=compensationColor, width=1, style=line.style_solid)

if showCompensationLabels and (bullishNoBottomWick or bearishNoTopWick)
    label.new(x=bar_index + barsToRight + 1, y=open, text="Compensation", style=label.style_label_left, color=compensationColor, textcolor=color.white, size=size.small)

// ============================================================================
// ALERTS (Optional)
// ============================================================================

// Alert conditions for no wick candles
alertcondition(bullishNoBottomWick, title="Bullish No Bottom Wick", message="Bullish candle with no bottom wick detected!")
alertcondition(bearishNoTopWick, title="Bearish No Top Wick", message="Bearish candle with no top wick detected!")

// Alert conditions for EMA trend changes
emaUpCross = ta.crossover(hlc3, usedEma)
emaDownCross = ta.crossunder(hlc3, usedEma)
alertcondition(emaUpCross, title="EMA Uptrend Start", message="Price crossed above EMA - Uptrend started!")
alertcondition(emaDownCross, title="EMA Downtrend Start", message="Price crossed below EMA - Downtrend started!")
