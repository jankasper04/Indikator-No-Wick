// Opening Range Breakout Strategy
// Based on LuxAlgo Opening Range with Breakouts & Targets
// Strategy Version with SL/TP Management

//@version=6
strategy("Opening Range Breakout Strategy", shorttitle = "ORB Strategy", overlay = true, 
         max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500,
         default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
         initial_capital = 10000, commission_type = strategy.commission.percent, commission_value = 0.1)

//---------------------------------------------------------------------------------------------------------------------}
// INPUTS
//---------------------------------------------------------------------------------------------------------------------{

// === Strategy Settings ===
grpStrategy = "Strategy Settings"
slType = input.string("Swing High/Low + ATR", title = "Stop Loss Type", options = ["Swing High/Low + ATR", "Middle of ORB Range"], group = grpStrategy, tooltip = "Swing High/Low + ATR: Uses last significant swing point with ATR buffer\nMiddle of ORB Range: Uses the midpoint of the Opening Range")
rrRatio = input.float(2.0, title = "Risk/Reward Ratio", minval = 0.5, maxval = 10, step = 0.5, group = grpStrategy, tooltip = "Take Profit is calculated based on this R:R ratio")
atrLength = input.int(14, title = "ATR Length", minval = 1, group = grpStrategy)
atrMultiplier = input.float(0.5, title = "ATR Buffer Multiplier", minval = 0.1, maxval = 3.0, step = 0.1, group = grpStrategy, tooltip = "Multiplier for ATR buffer on Swing SL")
swingLookback = input.int(5, title = "Swing Lookback", minval = 2, maxval = 20, group = grpStrategy, tooltip = "Number of bars to look back for swing high/low detection")

// === Trade Direction ===
grpDirection = "Trade Direction"
allowLong = input.bool(true, title = "Allow Long Trades", group = grpDirection)
allowShort = input.bool(true, title = "Allow Short Trades", group = grpDirection)

// === Opening Range Settings ===
grpOR = "Opening Range"
orMinutes = input.int(15, title = "Opening Range Duration (Minutes)", minval = 5, maxval = 60, step = 5, group = grpOR, tooltip = "Duration of the Opening Range in minutes")
crTog = input.bool(false, title = "", inline = "Custom", group = grpOR)
crSesh = input.session("0930-0945", title = "", inline = "Custom", group = grpOR)
tz = input.string("UTC-5", title = "", group = grpOR, inline = "Custom", options = ["UTC-10", "UTC-8", "UTC-7", "UTC-6", "UTC-5", "UTC-4", "UTC-3", "UTC+0", "UTC+1", "UTC+2", "UTC+3", "UTC+3:30", "UTC+4", "UTC+5", "UTC+5:30", "UTC+5:45", "UTC+6","UTC+6:30", "UTC+7", "UTC+8", "UTC+9", "UTC+9:30", "UTC+10", "UTC+11", "UTC+12", "UTC+12:45", "UTC+13"], tooltip = "Enable custom session for Opening Range")

// === Display Settings ===
grpDisplay = "Display"
showHist = input.bool(true, title = "Show Historical Data", group = grpDisplay)
showSignals = input.bool(true, title = "Show Entry Signals", group = grpDisplay)
showSLTP = input.bool(true, title = "Show SL/TP Lines", group = grpDisplay)

// === Style Settings ===
grpStyle = "Style"
bullColor = input.color(color.new(#089981, 60), title = "Bull Color", group = grpStyle)
bearColor = input.color(color.new(#f23645, 60), title = "Bear Color", group = grpStyle)
orColor = input.color(#787b86, title = "OR Levels Color", group = grpStyle)
orFillColor = input.color(color.new(color.gray, 70), title = "OR Fill Color", group = grpStyle)
slColor = input.color(color.new(color.red, 0), title = "Stop Loss Color", group = grpStyle)
tpColor = input.color(color.new(color.green, 0), title = "Take Profit Color", group = grpStyle)

invis = color.rgb(0, 0, 0, 100)

//---------------------------------------------------------------------------------------------------------------------}
// ERROR CHECK
//---------------------------------------------------------------------------------------------------------------------{

if timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds("D")
    runtime.error("Timeframe is too high! Please use a timeframe less than 1 Day.")

//---------------------------------------------------------------------------------------------------------------------}
// VARIABLES
//---------------------------------------------------------------------------------------------------------------------{

var bool or_sesh = false
var bool or_token = false
var bool or_complete = false

var float orh = na          // Opening Range High
var float orl = na          // Opening Range Low
var float orm = na          // Opening Range Middle

var int or_start_bar = na
var int or_end_bar = na

var box or_bx = na
var line h_ln = na
var line l_ln = na
var line m_ln = na
var label h_lab = na
var label l_lab = na

// Trade management variables
var float entryPrice = na
var float stopLoss = na
var float takeProfit = na
var bool longSignal = false
var bool shortSignal = false

var line sl_line = na
var line tp_line = na
var label sl_label = na
var label tp_label = na

// Swing detection variables
var float lastSwingHigh = na
var float lastSwingLow = na

//---------------------------------------------------------------------------------------------------------------------}
// FUNCTIONS
//---------------------------------------------------------------------------------------------------------------------{

// Function to detect swing high
isSwingHigh(src, left, right) =>
    pivotHigh = true
    for i = 1 to left
        if src[i] >= src[0]
            pivotHigh := false
            break
    for i = 1 to right
        if src[i + left] > src[left]
            pivotHigh := false
            break
    pivotHigh ? src[left] : na

// Function to detect swing low
isSwingLow(src, left, right) =>
    pivotLow = true
    for i = 1 to left
        if src[i] <= src[0]
            pivotLow := false
            break
    for i = 1 to right
        if src[i + left] < src[left]
            pivotLow := false
            break
    pivotLow ? src[left] : na

// Calculate ATR
atrValue = ta.atr(atrLength)

// Find last swing high within lookback period
findLastSwingHigh() =>
    float swingH = na
    for i = 0 to 50
        ph = ta.pivothigh(high, swingLookback, swingLookback)
        if not na(ph[i])
            swingH := ph[i]
            break
    swingH

// Find last swing low within lookback period  
findLastSwingLow() =>
    float swingL = na
    for i = 0 to 50
        pl = ta.pivotlow(low, swingLookback, swingLookback)
        if not na(pl[i])
            swingL := pl[i]
            break
    swingL

//---------------------------------------------------------------------------------------------------------------------}
// OPENING RANGE DETECTION
//---------------------------------------------------------------------------------------------------------------------{

// Calculate OR timeframe based on minutes input
orTF = str.tostring(orMinutes)

// Detect OR session
new_tf = timeframe.change(orTF)

if crTog
    or_sesh := not na(time(timeframe.period, crSesh, tz))
else 
    if session.isfirstbar
        or_sesh := true
        or_complete := false
    else if not session.isfirstbar and new_tf
        or_sesh := false

or_start = or_sesh and not or_sesh[1]
or_end = or_sesh[1] and not or_sesh

// On Start of OR Session
if or_start
    // Clean up old drawings if not showing historical
    if showHist == false
        or_bx.delete()
        h_ln.delete()
        l_ln.delete()
        m_ln.delete()
        sl_line.delete()
        tp_line.delete()
    
    h_lab.delete()
    l_lab.delete()
    sl_label.delete()
    tp_label.delete()
    
    orh := high
    orl := low
    or_start_bar := bar_index
    or_token := false
    or_complete := false
    longSignal := false
    shortSignal := false
    
    or_bx := box.new(bar_index, high, bar_index, low, bgcolor = orFillColor, border_color = orColor, border_width = 1)

// During OR Session
if or_sesh
    if high > orh
        orh := high
    if low < orl
        orl := low
    or_bx.set_top(orh)
    or_bx.set_bottom(orl)
    or_bx.set_right(bar_index)
    if orh != orl
        or_token := true

// On End of OR Session
if or_end and or_token
    orm := math.avg(orh, orl)
    or_end_bar := bar_index
    or_complete := true
    
    // Draw OR lines
    h_ln := line.new(bar_index, orh, bar_index, orh, color = orColor, width = 2)
    l_ln := line.new(bar_index, orl, bar_index, orl, color = orColor, width = 2)
    m_ln := line.new(bar_index, orm, bar_index, orm, style = line.style_dashed, color = orColor)
    
    h_lab := label.new(bar_index, orh, text = "ORH: " + str.tostring(orh, format.mintick), 
                       style = label.style_label_left, color = invis, textcolor = orColor, size = size.small)
    l_lab := label.new(bar_index, orl, text = "ORL: " + str.tostring(orl, format.mintick), 
                       style = label.style_label_left, color = invis, textcolor = orColor, size = size.small)
    
    // Store swing values for SL calculation
    lastSwingHigh := findLastSwingHigh()
    lastSwingLow := findLastSwingLow()

// Extend OR lines after session
if not or_sesh and or_complete
    h_ln.set_x2(bar_index)
    l_ln.set_x2(bar_index)
    m_ln.set_x2(bar_index)
    h_lab.set_x(bar_index)
    l_lab.set_x(bar_index)

//---------------------------------------------------------------------------------------------------------------------}
// ENTRY SIGNALS - M5 Candle Close Breakout
//---------------------------------------------------------------------------------------------------------------------{

// Calculate OR values for signal detection
orWidth = math.abs(orh - orl)

// Long Signal: M5 candle closes above ORH
longBreakout = not or_sesh and or_complete and close > orh and close[1] <= orh and strategy.position_size == 0

// Short Signal: M5 candle closes below ORL
shortBreakout = not or_sesh and or_complete and close < orl and close[1] >= orl and strategy.position_size == 0

//---------------------------------------------------------------------------------------------------------------------}
// STOP LOSS CALCULATION
//---------------------------------------------------------------------------------------------------------------------{

// Calculate Stop Loss based on selected type
calcLongSL() =>
    float sl = na
    if slType == "Middle of ORB Range"
        sl := orm
    else  // Swing High/Low + ATR
        // Use last swing low with ATR buffer
        swingLow = findLastSwingLow()
        if na(swingLow)
            swingLow := orl
        sl := swingLow - (atrValue * atrMultiplier)
    sl

calcShortSL() =>
    float sl = na
    if slType == "Middle of ORB Range"
        sl := orm
    else  // Swing High/Low + ATR
        // Use last swing high with ATR buffer
        swingHigh = findLastSwingHigh()
        if na(swingHigh)
            swingHigh := orh
        sl := swingHigh + (atrValue * atrMultiplier)
    sl

//---------------------------------------------------------------------------------------------------------------------}
// TAKE PROFIT CALCULATION (Based on R:R)
//---------------------------------------------------------------------------------------------------------------------{

calcLongTP(entry, sl) =>
    risk = math.abs(entry - sl)
    tp = entry + (risk * rrRatio)
    tp

calcShortTP(entry, sl) =>
    risk = math.abs(sl - entry)
    tp = entry - (risk * rrRatio)
    tp

//---------------------------------------------------------------------------------------------------------------------}
// STRATEGY EXECUTION
//---------------------------------------------------------------------------------------------------------------------{

// Long Entry
if longBreakout and allowLong
    entryPrice := close
    stopLoss := calcLongSL()
    takeProfit := calcLongTP(entryPrice, stopLoss)
    
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop = stopLoss, limit = takeProfit)
    
    longSignal := true
    
    // Draw SL/TP lines
    if showSLTP
        sl_line.delete()
        tp_line.delete()
        sl_label.delete()
        tp_label.delete()
        
        sl_line := line.new(bar_index, stopLoss, bar_index + 20, stopLoss, color = slColor, style = line.style_dashed, width = 2)
        tp_line := line.new(bar_index, takeProfit, bar_index + 20, takeProfit, color = tpColor, style = line.style_dashed, width = 2)
        sl_label := label.new(bar_index + 20, stopLoss, text = "SL: " + str.tostring(stopLoss, format.mintick), 
                              style = label.style_label_left, color = invis, textcolor = slColor, size = size.small)
        tp_label := label.new(bar_index + 20, takeProfit, text = "TP: " + str.tostring(takeProfit, format.mintick) + " (RR " + str.tostring(rrRatio) + ")", 
                              style = label.style_label_left, color = invis, textcolor = tpColor, size = size.small)

// Short Entry
if shortBreakout and allowShort
    entryPrice := close
    stopLoss := calcShortSL()
    takeProfit := calcShortTP(entryPrice, stopLoss)
    
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop = stopLoss, limit = takeProfit)
    
    shortSignal := true
    
    // Draw SL/TP lines
    if showSLTP
        sl_line.delete()
        tp_line.delete()
        sl_label.delete()
        tp_label.delete()
        
        sl_line := line.new(bar_index, stopLoss, bar_index + 20, stopLoss, color = slColor, style = line.style_dashed, width = 2)
        tp_line := line.new(bar_index, takeProfit, bar_index + 20, takeProfit, color = tpColor, style = line.style_dashed, width = 2)
        sl_label := label.new(bar_index + 20, stopLoss, text = "SL: " + str.tostring(stopLoss, format.mintick), 
                              style = label.style_label_left, color = invis, textcolor = slColor, size = size.small)
        tp_label := label.new(bar_index + 20, takeProfit, text = "TP: " + str.tostring(takeProfit, format.mintick) + " (RR " + str.tostring(rrRatio) + ")", 
                              style = label.style_label_left, color = invis, textcolor = tpColor, size = size.small)

//---------------------------------------------------------------------------------------------------------------------}
// VISUAL SIGNALS
//---------------------------------------------------------------------------------------------------------------------{

// Plot entry signals
plotshape(longBreakout and allowLong and showSignals, title = "Long Signal", location = location.belowbar, 
          style = shape.triangleup, size = size.small, color = bullColor, text = "LONG")

plotshape(shortBreakout and allowShort and showSignals, title = "Short Signal", location = location.abovebar, 
          style = shape.triangledown, size = size.small, color = bearColor, text = "SHORT")

// Background color during OR session
bgcolor(or_sesh ? color.new(color.blue, 90) : na, title = "OR Session Background")

//---------------------------------------------------------------------------------------------------------------------}
// INFO TABLE
//---------------------------------------------------------------------------------------------------------------------{

var table infoTable = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 80), border_width = 1)

if barstate.islast and or_complete
    table.cell(infoTable, 0, 0, "ORB Strategy Info", text_color = color.white, text_size = size.small)
    table.cell(infoTable, 1, 0, "", text_color = color.white, text_size = size.small)
    
    table.cell(infoTable, 0, 1, "OR High:", text_color = color.white, text_size = size.tiny)
    table.cell(infoTable, 1, 1, str.tostring(orh, format.mintick), text_color = bullColor, text_size = size.tiny)
    
    table.cell(infoTable, 0, 2, "OR Low:", text_color = color.white, text_size = size.tiny)
    table.cell(infoTable, 1, 2, str.tostring(orl, format.mintick), text_color = bearColor, text_size = size.tiny)
    
    table.cell(infoTable, 0, 3, "OR Middle:", text_color = color.white, text_size = size.tiny)
    table.cell(infoTable, 1, 3, str.tostring(orm, format.mintick), text_color = orColor, text_size = size.tiny)
    
    table.cell(infoTable, 0, 4, "OR Width:", text_color = color.white, text_size = size.tiny)
    table.cell(infoTable, 1, 4, str.tostring(orWidth, format.mintick), text_color = color.white, text_size = size.tiny)
    
    table.cell(infoTable, 0, 5, "SL Type:", text_color = color.white, text_size = size.tiny)
    table.cell(infoTable, 1, 5, slType, text_color = slColor, text_size = size.tiny)
    
    table.cell(infoTable, 0, 6, "R:R Ratio:", text_color = color.white, text_size = size.tiny)
    table.cell(infoTable, 1, 6, str.tostring(rrRatio), text_color = tpColor, text_size = size.tiny)
    
    table.cell(infoTable, 0, 7, "ATR (" + str.tostring(atrLength) + "):", text_color = color.white, text_size = size.tiny)
    table.cell(infoTable, 1, 7, str.tostring(atrValue, format.mintick), text_color = color.white, text_size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// ALERTS
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(longBreakout and allowLong, title = "Long Breakout", message = "ORB Long Breakout Signal!")
alertcondition(shortBreakout and allowShort, title = "Short Breakout", message = "ORB Short Breakout Signal!")
alertcondition(longBreakout or shortBreakout, title = "Any Breakout", message = "ORB Breakout Signal!")

//---------------------------------------------------------------------------------------------------------------------}
