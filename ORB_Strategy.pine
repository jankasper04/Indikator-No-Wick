// Opening Range Breakout Strategy
// Based on LuxAlgo Opening Range with Breakouts & Targets
// Strategy Version with SL/TP Management

//@version=6
strategy("Opening Range Breakout Strategy", shorttitle = "ORB Strategy", overlay = true, 
         max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500,
         default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
         initial_capital = 10000, commission_type = strategy.commission.percent, commission_value = 0.1,
         calc_on_every_tick = false, process_orders_on_close = true)

//---------------------------------------------------------------------------------------------------------------------}
// INPUTS
//---------------------------------------------------------------------------------------------------------------------{

// === Strategy Settings ===
grpStrategy = "Strategy Settings"
slType = input.string("Swing High/Low + ATR", title = "Stop Loss Type", options = ["Swing High/Low + ATR", "Middle of ORB Range"], group = grpStrategy, tooltip = "Swing High/Low + ATR: Uses last significant swing point with ATR buffer\nMiddle of ORB Range: Uses the midpoint of the Opening Range")
rrRatio = input.float(2.0, title = "Risk/Reward Ratio", minval = 0.5, maxval = 10, step = 0.5, group = grpStrategy, tooltip = "Take Profit is calculated based on this R:R ratio")
atrLength = input.int(14, title = "ATR Length", minval = 1, group = grpStrategy)
atrMultiplier = input.float(0.5, title = "ATR Buffer Multiplier", minval = 0.1, maxval = 3.0, step = 0.1, group = grpStrategy, tooltip = "Multiplier for ATR buffer on Swing SL")
swingLookback = input.int(5, title = "Swing Lookback", minval = 2, maxval = 20, group = grpStrategy, tooltip = "Number of bars to look back for swing high/low detection")

// === Trade Direction ===
grpDirection = "Trade Direction"
allowLong = input.bool(true, title = "Allow Long Trades", group = grpDirection)
allowShort = input.bool(true, title = "Allow Short Trades", group = grpDirection)
onlyOneTradePerDay = input.bool(true, title = "Only One Trade Per Day", group = grpDirection)

// === Opening Range Settings ===
grpOR = "Opening Range"
orSession = input.session("1530-1545", title = "Opening Range Session", group = grpOR, tooltip = "Time window for the Opening Range (in your chart's timezone)")
tz = input.string("UTC+1", title = "Timezone", group = grpOR, options = ["UTC-10", "UTC-8", "UTC-7", "UTC-6", "UTC-5", "UTC-4", "UTC-3", "UTC+0", "UTC+1", "UTC+2", "UTC+3", "UTC+3:30", "UTC+4", "UTC+5", "UTC+5:30", "UTC+5:45", "UTC+6","UTC+6:30", "UTC+7", "UTC+8", "UTC+9", "UTC+9:30", "UTC+10", "UTC+11", "UTC+12", "UTC+12:45", "UTC+13"])
tradingSession = input.session("1545-2200", title = "Trading Session (after OR)", group = grpOR, tooltip = "Time window when trades are allowed after Opening Range")

// === Display Settings ===
grpDisplay = "Display"
showHist = input.bool(true, title = "Show Historical Data", group = grpDisplay)
showSignals = input.bool(true, title = "Show Entry Signals", group = grpDisplay)
showSLTP = input.bool(true, title = "Show SL/TP Lines", group = grpDisplay)
showDebug = input.bool(false, title = "Show Debug Info", group = grpDisplay)

// === Style Settings ===
grpStyle = "Style"
bullColor = input.color(color.new(#089981, 60), title = "Bull Color", group = grpStyle)
bearColor = input.color(color.new(#f23645, 60), title = "Bear Color", group = grpStyle)
orColor = input.color(#787b86, title = "OR Levels Color", group = grpStyle)
orFillColor = input.color(color.new(color.gray, 70), title = "OR Fill Color", group = grpStyle)
slColor = input.color(color.new(color.red, 0), title = "Stop Loss Color", group = grpStyle)
tpColor = input.color(color.new(color.green, 0), title = "Take Profit Color", group = grpStyle)

invis = color.rgb(0, 0, 0, 100)

//---------------------------------------------------------------------------------------------------------------------}
// TIME-BASED SESSION DETECTION
//---------------------------------------------------------------------------------------------------------------------{

// Detect if we're in the Opening Range session
inORSession = not na(time(timeframe.period, orSession, tz))
inTradingSession = not na(time(timeframe.period, tradingSession, tz))

// Detect session transitions
orSessionStart = inORSession and not inORSession[1]
orSessionEnd = not inORSession and inORSession[1]

// New trading day detection
newDay = dayofweek != dayofweek[1]

//---------------------------------------------------------------------------------------------------------------------}
// VARIABLES
//---------------------------------------------------------------------------------------------------------------------{

var float orh = na          // Opening Range High
var float orl = na          // Opening Range Low
var float orm = na          // Opening Range Middle
var float orWidth = na      // Opening Range Width

var bool orComplete = false
var bool tradedToday = false

var int or_start_bar = na

var box or_bx = na
var line h_ln = na
var line l_ln = na
var line m_ln = na
var label h_lab = na
var label l_lab = na

var line sl_line = na
var line tp_line = na
var label sl_label = na
var label tp_label = na

// ATR for buffer
atrValue = ta.atr(atrLength)

//---------------------------------------------------------------------------------------------------------------------}
// FUNCTIONS
//---------------------------------------------------------------------------------------------------------------------{

// Find last swing high
findSwingHigh() =>
    float swingH = na
    for i = swingLookback to 50
        if high[i] >= high[i-1] and high[i] >= high[i+1] and high[i] >= high[i-2] and high[i] >= high[i+2]
            swingH := high[i]
            break
    na(swingH) ? orh : swingH

// Find last swing low
findSwingLow() =>
    float swingL = na
    for i = swingLookback to 50
        if low[i] <= low[i-1] and low[i] <= low[i+1] and low[i] <= low[i-2] and low[i] <= low[i+2]
            swingL := low[i]
            break
    na(swingL) ? orl : swingL

//---------------------------------------------------------------------------------------------------------------------}
// OPENING RANGE DETECTION
//---------------------------------------------------------------------------------------------------------------------{

// Reset on new day
if newDay
    tradedToday := false
    orComplete := false

// On Start of OR Session
if orSessionStart
    // Clean up old drawings if not showing historical
    if showHist == false
        or_bx.delete()
        h_ln.delete()
        l_ln.delete()
        m_ln.delete()
        sl_line.delete()
        tp_line.delete()
    
    h_lab.delete()
    l_lab.delete()
    sl_label.delete()
    tp_label.delete()
    
    orh := high
    orl := low
    or_start_bar := bar_index
    orComplete := false
    
    or_bx := box.new(bar_index, high, bar_index, low, bgcolor = orFillColor, border_color = orColor, border_width = 1)

// During OR Session - update high/low
if inORSession
    if high > orh
        orh := high
    if low < orl
        orl := low
    or_bx.set_top(orh)
    or_bx.set_bottom(orl)
    or_bx.set_right(bar_index)

// On End of OR Session
if orSessionEnd
    orm := (orh + orl) / 2
    orWidth := orh - orl
    orComplete := true
    
    // Draw OR lines
    h_ln := line.new(bar_index, orh, bar_index, orh, color = orColor, width = 2)
    l_ln := line.new(bar_index, orl, bar_index, orl, color = orColor, width = 2)
    m_ln := line.new(bar_index, orm, bar_index, orm, style = line.style_dashed, color = orColor)
    
    h_lab := label.new(bar_index, orh, text = "ORH: " + str.tostring(orh, format.mintick), 
                       style = label.style_label_left, color = invis, textcolor = orColor, size = size.small)
    l_lab := label.new(bar_index, orl, text = "ORL: " + str.tostring(orl, format.mintick), 
                       style = label.style_label_left, color = invis, textcolor = orColor, size = size.small)

// Extend OR lines
if orComplete and not inORSession
    h_ln.set_x2(bar_index)
    l_ln.set_x2(bar_index)
    m_ln.set_x2(bar_index)
    h_lab.set_x(bar_index)
    l_lab.set_x(bar_index)

//---------------------------------------------------------------------------------------------------------------------}
// ENTRY CONDITIONS
//---------------------------------------------------------------------------------------------------------------------{

// Check if we can trade
canTrade = orComplete and inTradingSession and strategy.position_size == 0
if onlyOneTradePerDay and tradedToday
    canTrade := false

// Long: Candle closes above ORH
longCondition = canTrade and close > orh and close[1] <= orh

// Short: Candle closes below ORL  
shortCondition = canTrade and close < orl and close[1] >= orl

//---------------------------------------------------------------------------------------------------------------------}
// STOP LOSS & TAKE PROFIT CALCULATION
//---------------------------------------------------------------------------------------------------------------------{

// Calculate Long SL
calcLongSL() =>
    float sl = na
    if slType == "Middle of ORB Range"
        sl := orm
    else  // Swing High/Low + ATR
        swingLow = findSwingLow()
        sl := swingLow - (atrValue * atrMultiplier)
    // Ensure SL is below entry
    sl := math.min(sl, orl - atrValue * 0.25)
    sl

// Calculate Short SL
calcShortSL() =>
    float sl = na
    if slType == "Middle of ORB Range"
        sl := orm
    else  // Swing High/Low + ATR
        swingHigh = findSwingHigh()
        sl := swingHigh + (atrValue * atrMultiplier)
    // Ensure SL is above entry
    sl := math.max(sl, orh + atrValue * 0.25)
    sl

// Calculate TP based on R:R
calcLongTP(entryPrice, sl) =>
    risk = entryPrice - sl
    entryPrice + (risk * rrRatio)

calcShortTP(entryPrice, sl) =>
    risk = sl - entryPrice
    entryPrice - (risk * rrRatio)

//---------------------------------------------------------------------------------------------------------------------}
// STRATEGY EXECUTION
//---------------------------------------------------------------------------------------------------------------------{

var float currentSL = na
var float currentTP = na

// Long Entry
if longCondition and allowLong
    entryPrice = close
    currentSL := calcLongSL()
    currentTP := calcLongTP(entryPrice, currentSL)
    
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop = currentSL, limit = currentTP)
    
    tradedToday := true
    
    // Draw SL/TP lines
    if showSLTP
        sl_line.delete()
        tp_line.delete()
        sl_label.delete()
        tp_label.delete()
        
        sl_line := line.new(bar_index, currentSL, bar_index + 50, currentSL, color = slColor, style = line.style_dashed, width = 2)
        tp_line := line.new(bar_index, currentTP, bar_index + 50, currentTP, color = tpColor, style = line.style_dashed, width = 2)
        sl_label := label.new(bar_index + 50, currentSL, text = "SL: " + str.tostring(currentSL, format.mintick), 
                              style = label.style_label_left, color = invis, textcolor = slColor, size = size.small)
        tp_label := label.new(bar_index + 50, currentTP, text = "TP: " + str.tostring(currentTP, format.mintick) + " (RR " + str.tostring(rrRatio) + ")", 
                              style = label.style_label_left, color = invis, textcolor = tpColor, size = size.small)

// Short Entry
if shortCondition and allowShort
    entryPrice = close
    currentSL := calcShortSL()
    currentTP := calcShortTP(entryPrice, currentSL)
    
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop = currentSL, limit = currentTP)
    
    tradedToday := true
    
    // Draw SL/TP lines
    if showSLTP
        sl_line.delete()
        tp_line.delete()
        sl_label.delete()
        tp_label.delete()
        
        sl_line := line.new(bar_index, currentSL, bar_index + 50, currentSL, color = slColor, style = line.style_dashed, width = 2)
        tp_line := line.new(bar_index, currentTP, bar_index + 50, currentTP, color = tpColor, style = line.style_dashed, width = 2)
        sl_label := label.new(bar_index + 50, currentSL, text = "SL: " + str.tostring(currentSL, format.mintick), 
                              style = label.style_label_left, color = invis, textcolor = slColor, size = size.small)
        tp_label := label.new(bar_index + 50, currentTP, text = "TP: " + str.tostring(currentTP, format.mintick) + " (RR " + str.tostring(rrRatio) + ")", 
                              style = label.style_label_left, color = invis, textcolor = tpColor, size = size.small)

//---------------------------------------------------------------------------------------------------------------------}
// VISUAL SIGNALS
//---------------------------------------------------------------------------------------------------------------------{

// Plot entry signals
plotshape(longCondition and allowLong and showSignals, title = "Long Signal", location = location.belowbar, 
          style = shape.triangleup, size = size.small, color = color.new(#089981, 0), text = "LONG")

plotshape(shortCondition and allowShort and showSignals, title = "Short Signal", location = location.abovebar, 
          style = shape.triangledown, size = size.small, color = color.new(#f23645, 0), text = "SHORT")

// Background colors
bgcolor(inORSession ? color.new(color.blue, 85) : na, title = "OR Session")
bgcolor(inTradingSession and orComplete ? color.new(color.green, 95) : na, title = "Trading Session")

// Plot OR levels for reference
plot(orComplete and not inORSession ? orh : na, "ORH", color = color.new(orColor, 50), style = plot.style_linebr)
plot(orComplete and not inORSession ? orl : na, "ORL", color = color.new(orColor, 50), style = plot.style_linebr)
plot(orComplete and not inORSession ? orm : na, "ORM", color = color.new(orColor, 70), style = plot.style_linebr, linewidth = 1)

//---------------------------------------------------------------------------------------------------------------------}
// DEBUG TABLE
//---------------------------------------------------------------------------------------------------------------------{

var table debugTable = table.new(position.top_right, 2, 10, bgcolor = color.new(color.black, 80), border_width = 1)

if barstate.islast and showDebug
    table.cell(debugTable, 0, 0, "ORB Debug", text_color = color.white, text_size = size.small)
    table.cell(debugTable, 1, 0, "", text_color = color.white, text_size = size.small)
    
    table.cell(debugTable, 0, 1, "In OR Session:", text_color = color.white, text_size = size.tiny)
    table.cell(debugTable, 1, 1, str.tostring(inORSession), text_color = inORSession ? color.green : color.red, text_size = size.tiny)
    
    table.cell(debugTable, 0, 2, "OR Complete:", text_color = color.white, text_size = size.tiny)
    table.cell(debugTable, 1, 2, str.tostring(orComplete), text_color = orComplete ? color.green : color.red, text_size = size.tiny)
    
    table.cell(debugTable, 0, 3, "In Trading Session:", text_color = color.white, text_size = size.tiny)
    table.cell(debugTable, 1, 3, str.tostring(inTradingSession), text_color = inTradingSession ? color.green : color.red, text_size = size.tiny)
    
    table.cell(debugTable, 0, 4, "ORH:", text_color = color.white, text_size = size.tiny)
    table.cell(debugTable, 1, 4, str.tostring(orh, format.mintick), text_color = bullColor, text_size = size.tiny)
    
    table.cell(debugTable, 0, 5, "ORL:", text_color = color.white, text_size = size.tiny)
    table.cell(debugTable, 1, 5, str.tostring(orl, format.mintick), text_color = bearColor, text_size = size.tiny)
    
    table.cell(debugTable, 0, 6, "ORM:", text_color = color.white, text_size = size.tiny)
    table.cell(debugTable, 1, 6, str.tostring(orm, format.mintick), text_color = orColor, text_size = size.tiny)
    
    table.cell(debugTable, 0, 7, "Can Trade:", text_color = color.white, text_size = size.tiny)
    table.cell(debugTable, 1, 7, str.tostring(canTrade), text_color = canTrade ? color.green : color.red, text_size = size.tiny)
    
    table.cell(debugTable, 0, 8, "Traded Today:", text_color = color.white, text_size = size.tiny)
    table.cell(debugTable, 1, 8, str.tostring(tradedToday), text_color = tradedToday ? color.orange : color.green, text_size = size.tiny)
    
    table.cell(debugTable, 0, 9, "Position:", text_color = color.white, text_size = size.tiny)
    table.cell(debugTable, 1, 9, str.tostring(strategy.position_size), text_color = color.white, text_size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// INFO TABLE (when not debugging)
//---------------------------------------------------------------------------------------------------------------------{

var table infoTable = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 80), border_width = 1)

if barstate.islast and not showDebug and orComplete
    table.cell(infoTable, 0, 0, "ORB Strategy", text_color = color.white, text_size = size.small)
    table.cell(infoTable, 1, 0, "", text_color = color.white, text_size = size.small)
    
    table.cell(infoTable, 0, 1, "ORH:", text_color = color.white, text_size = size.tiny)
    table.cell(infoTable, 1, 1, str.tostring(orh, format.mintick), text_color = bullColor, text_size = size.tiny)
    
    table.cell(infoTable, 0, 2, "ORL:", text_color = color.white, text_size = size.tiny)
    table.cell(infoTable, 1, 2, str.tostring(orl, format.mintick), text_color = bearColor, text_size = size.tiny)
    
    table.cell(infoTable, 0, 3, "ORM:", text_color = color.white, text_size = size.tiny)
    table.cell(infoTable, 1, 3, str.tostring(orm, format.mintick), text_color = orColor, text_size = size.tiny)
    
    table.cell(infoTable, 0, 4, "SL Type:", text_color = color.white, text_size = size.tiny)
    table.cell(infoTable, 1, 4, slType == "Middle of ORB Range" ? "ORM" : "Swing+ATR", text_color = slColor, text_size = size.tiny)
    
    table.cell(infoTable, 0, 5, "R:R:", text_color = color.white, text_size = size.tiny)
    table.cell(infoTable, 1, 5, str.tostring(rrRatio), text_color = tpColor, text_size = size.tiny)

//---------------------------------------------------------------------------------------------------------------------}
// ALERTS
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(longCondition and allowLong, title = "Long Breakout", message = "ORB Long Breakout Signal!")
alertcondition(shortCondition and allowShort, title = "Short Breakout", message = "ORB Short Breakout Signal!")
alertcondition(longCondition or shortCondition, title = "Any Breakout", message = "ORB Breakout Signal!")

//---------------------------------------------------------------------------------------------------------------------}
