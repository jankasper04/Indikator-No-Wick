//@version=6
indicator("iFVG Multi-Timeframe Strategy", shorttitle = "iFVG MTF Strategy", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
//Settings
//---------------------------------------------------------------------------------------------------------------------{

//Timeframe Settings
tf_liq      = input.timeframe("60", title = "Liquidity Sweep TF", group = "Timeframe Settings", tooltip = "H1 or M15 for Liquidity Sweep Detection")
tf_htf      = input.timeframe("15", title = "HTF FVG Timeframe", group = "Timeframe Settings", tooltip = "M5, M15 or H1 for Higher TF FVG")

//Detection Settings
swingLen    = input.int(5, title = "Swing Length", minval = 2, maxval = 20, group = "Detection Settings")
minFvgSize  = input.float(5.0, title = "Min FVG Size (Points)", minval = 0.1, group = "Detection Settings")
ifvgLookback = input.int(50, title = "iFVG Lookback", minval = 10, maxval = 200, group = "Detection Settings")
liqLookback = input.int(20, title = "Liquidity Lookback", minval = 5, maxval = 100, group = "Detection Settings")

//Display Settings
showHist    = input.bool(true, title = "Show Historical Data", group = "Display Settings", tooltip = "Displays All Data from Previous Sessions")
showLiq     = input.bool(true, title = "Show Liquidity Levels", group = "Display Settings")
showHtfFvg  = input.bool(true, title = "Show HTF FVG Zones", group = "Display Settings")
showIfvg    = input.bool(true, title = "Show iFVG Zones", group = "Display Settings")
showCisd    = input.bool(true, title = "Show CISD Signals", group = "Display Settings")
showLabels  = input.bool(true, title = "Show Labels", group = "Display Settings")
showSignals = input.bool(true, title = "Show Entry Signals", group = "Display Settings")

//Signal Settings
sigSize     = str.lower(input.string("Small", title = "Signal Size", options = ["Tiny","Small","Normal","Large","Huge"], group = "Signal Settings"))
txtSize     = str.lower(input.string("Small", title = "Text Size", options = ["Tiny","Small","Normal","Large","Huge"], group = "Signal Settings"))

//Style
bullColor   = input.color(color.new(#089981,60), title = "Bull Color", group = "Style", inline = "Bull")
bullFill    = input.color(color.new(#089981,80), title = "Bull Fill", group = "Style", inline = "Bull")
bearColor   = input.color(color.new(#f23645,60), title = "Bear Color", group = "Style", inline = "Bear")
bearFill    = input.color(color.new(#f23645,80), title = "Bear Fill", group = "Style", inline = "Bear")
bslColor    = input.color(color.new(#089981,50), title = "BSL Color", group = "Style", inline = "Liq")
sslColor    = input.color(color.new(#f23645,50), title = "SSL Color", group = "Style", inline = "Liq")
sweepColor  = input.color(color.yellow, title = "Sweep Color", group = "Style")
cisdBullCol = input.color(color.lime, title = "CISD Bull", group = "Style", inline = "CISD")
cisdBearCol = input.color(color.fuchsia, title = "CISD Bear", group = "Style", inline = "CISD")

invis = color.rgb(0,0,0,100)

//---------------------------------------------------------------------------------------------------------------------}
//Error
//---------------------------------------------------------------------------------------------------------------------{

if timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds("D")
    runtime.error("Timeframe is too High! Please use a timeframe less than 1 Day.")

//---------------------------------------------------------------------------------------------------------------------}
//UDTs
//---------------------------------------------------------------------------------------------------------------------{

type fvgZone
    float top
    float bottom
    int   startBar
    bool  isBull

type liqLevel
    float price
    int   bar

//---------------------------------------------------------------------------------------------------------------------}
//Functions
//---------------------------------------------------------------------------------------------------------------------{

swingHigh(len) => ta.pivothigh(high, len, len)
swingLow(len) => ta.pivotlow(low, len, len)

isBullFvg() => low > high[2]
isBearFvg() => high < low[2]

isCisdBull() =>
    body = close - open
    rangeSize = high - low
    bodyRatio = rangeSize > 0 ? body / rangeSize : 0
    prevBearish = close[1] < open[1] and close[2] < open[2]
    body > 0 and bodyRatio > 0.6 and prevBearish

isCisdBear() =>
    body = open - close
    rangeSize = high - low
    bodyRatio = rangeSize > 0 ? body / rangeSize : 0
    prevBullish = close[1] > open[1] and close[2] > open[2]
    body > 0 and bodyRatio > 0.6 and prevBullish

//---------------------------------------------------------------------------------------------------------------------}
//Variables
//---------------------------------------------------------------------------------------------------------------------{

var array<liqLevel> bslLevels = array.new<liqLevel>()
var array<liqLevel> sslLevels = array.new<liqLevel>()
var array<fvgZone>  fvgZones  = array.new<fvgZone>()

var array<line>  liqLines   = array.new_line()
var array<box>   fvgBoxes   = array.new_box()
var array<label> sigLabels  = array.new_label()

var bool recentSslSweep    = false
var bool recentBslSweep    = false
var bool recentHtfBullFvg  = false
var bool recentHtfBearFvg  = false

var int sweepBar    = 0
var int htfFvgBar   = 0

var float ifvgEntry = na
var float ifvgSl    = na

bslSweep = false
sslSweep = false
ifvgBullSignal = false
ifvgBearSignal = false

//---------------------------------------------------------------------------------------------------------------------}
//HTF Data
//---------------------------------------------------------------------------------------------------------------------{

[htfHigh, htfLow, htfHigh2, htfLow2] = request.security(syminfo.tickerid, tf_htf, [high, low, high[2], low[2]])

htfBullFvg = htfLow > htfHigh2
htfBearFvg = htfHigh < htfLow2

//---------------------------------------------------------------------------------------------------------------------}
//Liquidity Detection
//---------------------------------------------------------------------------------------------------------------------{

sh = swingHigh(swingLen)
sl = swingLow(swingLen)

//Add new swing highs (Buy-Side Liquidity)
if not na(sh)
    bslLevels.push(liqLevel.new(sh, bar_index - swingLen))
    if bslLevels.size() > liqLookback
        bslLevels.shift()

//Add new swing lows (Sell-Side Liquidity)
if not na(sl)
    sslLevels.push(liqLevel.new(sl, bar_index - swingLen))
    if sslLevels.size() > liqLookback
        sslLevels.shift()

//BSL Sweep Detection
if bslLevels.size() > 0
    for i = 0 to bslLevels.size() - 1
        lvl = bslLevels.get(i)
        if high > lvl.price and close < lvl.price
            bslSweep := true
            break

//SSL Sweep Detection
if sslLevels.size() > 0
    for i = 0 to sslLevels.size() - 1
        lvl = sslLevels.get(i)
        if low < lvl.price and close > lvl.price
            sslSweep := true
            break

//---------------------------------------------------------------------------------------------------------------------}
//FVG Detection
//---------------------------------------------------------------------------------------------------------------------{

bullFvg = isBullFvg()
bearFvg = isBearFvg()
fvgMinPts = minFvgSize * syminfo.mintick

//Store new FVGs
if bullFvg and (low - high[2]) >= fvgMinPts
    fvgZones.push(fvgZone.new(low, high[2], bar_index - 2, true))

if bearFvg and (low[2] - high) >= fvgMinPts
    fvgZones.push(fvgZone.new(low[2], high, bar_index - 2, false))

//---------------------------------------------------------------------------------------------------------------------}
//iFVG Detection
//---------------------------------------------------------------------------------------------------------------------{

if fvgZones.size() > 0
    for i = fvgZones.size() - 1 to 0
        if i >= fvgZones.size()
            continue
            
        zone = fvgZones.get(i)
        
        //Remove old FVGs
        if bar_index - zone.startBar > ifvgLookback
            fvgZones.remove(i)
            continue
        
        //Bullish iFVG: Originally bearish FVG, price closes above
        if not zone.isBull and close > zone.top and close[1] <= zone.top
            ifvgBullSignal := true
            ifvgEntry := zone.top
            ifvgSl := zone.bottom
            fvgZones.remove(i)
            break
            
        //Bearish iFVG: Originally bullish FVG, price closes below
        if zone.isBull and close < zone.bottom and close[1] >= zone.bottom
            ifvgBearSignal := true
            ifvgEntry := zone.bottom
            ifvgSl := zone.top
            fvgZones.remove(i)
            break

//---------------------------------------------------------------------------------------------------------------------}
//CISD Detection
//---------------------------------------------------------------------------------------------------------------------{

cisdBull = isCisdBull()
cisdBear = isCisdBear()

//---------------------------------------------------------------------------------------------------------------------}
//Setup Tracking
//---------------------------------------------------------------------------------------------------------------------{

//Update sweep tracking
if sslSweep
    recentSslSweep := true
    sweepBar := bar_index
    
if bslSweep
    recentBslSweep := true
    sweepBar := bar_index

//Decay old signals (valid for 50 bars)
if bar_index - sweepBar > 50
    recentSslSweep := false
    recentBslSweep := false

//HTF FVG tracking
if htfBullFvg
    recentHtfBullFvg := true
    htfFvgBar := bar_index
    
if htfBearFvg
    recentHtfBearFvg := true
    htfFvgBar := bar_index

if bar_index - htfFvgBar > 50
    recentHtfBullFvg := false
    recentHtfBearFvg := false

//Full Setup Conditions
fullLongSetup  = recentSslSweep and recentHtfBullFvg and ifvgBullSignal and cisdBull
fullShortSetup = recentBslSweep and recentHtfBearFvg and ifvgBearSignal and cisdBear

//---------------------------------------------------------------------------------------------------------------------}
//Display
//---------------------------------------------------------------------------------------------------------------------{

//Liquidity Sweep Signals
plotshape(sslSweep and showLabels, title = "SSL Sweep", location = location.belowbar, style = shape.triangleup, size = size.small, color = sweepColor, text = "SSL")
plotshape(bslSweep and showLabels, title = "BSL Sweep", location = location.abovebar, style = shape.triangledown, size = size.small, color = sweepColor, text = "BSL")

//CISD Signals
plotshape(showCisd and cisdBull, title = "CISD Bull", location = location.belowbar, style = shape.diamond, size = size.tiny, color = cisdBullCol, text = "CISD")
plotshape(showCisd and cisdBear, title = "CISD Bear", location = location.abovebar, style = shape.diamond, size = size.tiny, color = cisdBearCol, text = "CISD")

//Full Setup Entry Signals
plotshape(showSignals and fullLongSetup, title = "LONG Setup", location = location.belowbar, style = shape.labelup, size = size.large, color = bullColor, text = "LONG", textcolor = color.white)
plotshape(showSignals and fullShortSetup, title = "SHORT Setup", location = location.abovebar, style = shape.labeldown, size = size.large, color = bearColor, text = "SHORT", textcolor = color.white)

//Background for setups
bgcolor(fullLongSetup ? color.new(bullColor, 90) : na, title = "Long BG")
bgcolor(fullShortSetup ? color.new(bearColor, 90) : na, title = "Short BG")

//Liquidity Lines
if showLiq and barstate.islast
    //Clear old lines
    for ln in liqLines
        if not showHist
            ln.delete()
    liqLines.clear()
    
    //Draw BSL lines
    if bslLevels.size() > 0
        for i = 0 to math.min(4, bslLevels.size() - 1)
            lvl = bslLevels.get(bslLevels.size() - 1 - i)
            liqLines.push(line.new(lvl.bar, lvl.price, bar_index, lvl.price, color = bslColor, style = line.style_dashed))
    
    //Draw SSL lines
    if sslLevels.size() > 0
        for i = 0 to math.min(4, sslLevels.size() - 1)
            lvl = sslLevels.get(sslLevels.size() - 1 - i)
            liqLines.push(line.new(lvl.bar, lvl.price, bar_index, lvl.price, color = sslColor, style = line.style_dashed))

//HTF FVG Boxes
if showHtfFvg and htfBullFvg
    box.new(bar_index - 3, htfLow, bar_index, htfHigh2, bgcolor = bullFill, border_color = bullColor)

if showHtfFvg and htfBearFvg
    box.new(bar_index - 3, htfLow2, bar_index, htfHigh, bgcolor = bearFill, border_color = bearColor)

//iFVG Boxes
if showIfvg and ifvgBullSignal
    box.new(bar_index - 2, ifvgSl, bar_index + 5, ifvgEntry, bgcolor = bullFill, border_color = bullColor, border_width = 2)
    if showLabels
        label.new(bar_index, ifvgEntry, text = "iFVG", style = label.style_label_left, color = invis, textcolor = bullColor, size = txtSize)

if showIfvg and ifvgBearSignal
    box.new(bar_index - 2, ifvgEntry, bar_index + 5, ifvgSl, bgcolor = bearFill, border_color = bearColor, border_width = 2)
    if showLabels
        label.new(bar_index, ifvgEntry, text = "iFVG", style = label.style_label_left, color = invis, textcolor = bearColor, size = txtSize)

//---------------------------------------------------------------------------------------------------------------------}
//Info Table
//---------------------------------------------------------------------------------------------------------------------{

var table infoTbl = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 80), border_width = 1)

if barstate.islast
    infoTbl.cell(0, 0, "iFVG Strategy", text_color = color.white, text_size = size.normal)
    infoTbl.cell(1, 0, "Status", text_color = color.white, text_size = size.normal)
    
    infoTbl.cell(0, 1, "SSL Sweep", text_color = color.gray, text_size = size.small)
    infoTbl.cell(1, 1, recentSslSweep ? "YES" : "-", text_color = recentSslSweep ? bullColor : color.gray, text_size = size.small)
    
    infoTbl.cell(0, 2, "BSL Sweep", text_color = color.gray, text_size = size.small)
    infoTbl.cell(1, 2, recentBslSweep ? "YES" : "-", text_color = recentBslSweep ? bearColor : color.gray, text_size = size.small)
    
    infoTbl.cell(0, 3, "HTF Bull FVG", text_color = color.gray, text_size = size.small)
    infoTbl.cell(1, 3, recentHtfBullFvg ? "YES" : "-", text_color = recentHtfBullFvg ? bullColor : color.gray, text_size = size.small)
    
    infoTbl.cell(0, 4, "HTF Bear FVG", text_color = color.gray, text_size = size.small)
    infoTbl.cell(1, 4, recentHtfBearFvg ? "YES" : "-", text_color = recentHtfBearFvg ? bearColor : color.gray, text_size = size.small)
    
    infoTbl.cell(0, 5, "CISD Bull", text_color = color.gray, text_size = size.small)
    infoTbl.cell(1, 5, cisdBull ? "YES" : "-", text_color = cisdBull ? bullColor : color.gray, text_size = size.small)
    
    infoTbl.cell(0, 6, "CISD Bear", text_color = color.gray, text_size = size.small)
    infoTbl.cell(1, 6, cisdBear ? "YES" : "-", text_color = cisdBear ? bearColor : color.gray, text_size = size.small)
    
    infoTbl.cell(0, 7, "SETUP", text_color = color.white, text_size = size.normal)
    setupTxt = fullLongSetup ? "LONG" : fullShortSetup ? "SHORT" : "-"
    setupCol = fullLongSetup ? bullColor : fullShortSetup ? bearColor : color.gray
    infoTbl.cell(1, 7, setupTxt, text_color = setupCol, text_size = size.normal)

//---------------------------------------------------------------------------------------------------------------------}
//Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(sslSweep, title = "SSL Sweep", message = "SSL Sweep on {{ticker}}")
alertcondition(bslSweep, title = "BSL Sweep", message = "BSL Sweep on {{ticker}}")
alertcondition(htfBullFvg, title = "HTF Bull FVG", message = "Bullish HTF FVG on {{ticker}}")
alertcondition(htfBearFvg, title = "HTF Bear FVG", message = "Bearish HTF FVG on {{ticker}}")
alertcondition(ifvgBullSignal, title = "Bullish iFVG", message = "Bullish iFVG on {{ticker}}")
alertcondition(ifvgBearSignal, title = "Bearish iFVG", message = "Bearish iFVG on {{ticker}}")
alertcondition(fullLongSetup, title = "FULL LONG", message = "FULL LONG SETUP on {{ticker}}")
alertcondition(fullShortSetup, title = "FULL SHORT", message = "FULL SHORT SETUP on {{ticker}}")

//---------------------------------------------------------------------------------------------------------------------}
