// This Pine Script code is subject to the terms of the Mozilla Public License 2.0
// iFVG Multi-Timeframe Strategy Indicator

//@version=5
indicator("iFVG Multi-Timeframe Strategy", shorttitle="iFVG MTF", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

//=============================================================================
// INPUTS
//=============================================================================

// Timeframe Settings
grp_tf = "Timeframe Settings"
tf_liquidity = input.timeframe("60", "Liquidity Sweep TF", group=grp_tf)
tf_htf_fvg = input.timeframe("15", "HTF FVG Timeframe", group=grp_tf)

// Detection Settings
grp_detect = "Detection Settings"
swing_length = input.int(5, "Swing Length", minval=2, maxval=20, group=grp_detect)
min_fvg_size = input.float(5.0, "Min FVG Size (Points)", minval=0.1, group=grp_detect)
ifvg_lookback = input.int(50, "iFVG Lookback", minval=10, maxval=200, group=grp_detect)
liquidity_lookback = input.int(20, "Liquidity Lookback", minval=5, maxval=100, group=grp_detect)

// Visual Settings
grp_visual = "Visual Settings"
col_bull_ifvg = input.color(color.new(color.green, 70), "Bullish iFVG", group=grp_visual)
col_bear_ifvg = input.color(color.new(color.red, 70), "Bearish iFVG", group=grp_visual)
col_bull_fvg = input.color(color.new(color.teal, 80), "Bullish HTF FVG", group=grp_visual)
col_bear_fvg = input.color(color.new(color.maroon, 80), "Bearish HTF FVG", group=grp_visual)
col_bsl = input.color(color.new(color.lime, 50), "Buy-Side Liquidity", group=grp_visual)
col_ssl = input.color(color.new(color.red, 50), "Sell-Side Liquidity", group=grp_visual)
col_sweep = input.color(color.yellow, "Liquidity Sweep", group=grp_visual)
show_htf_fvg = input.bool(true, "Show HTF FVG Zones", group=grp_visual)
show_liquidity = input.bool(true, "Show Liquidity Levels", group=grp_visual)
show_ifvg = input.bool(true, "Show iFVG Zones", group=grp_visual)
show_cisd = input.bool(true, "Show CISD Signals", group=grp_visual)
show_labels = input.bool(true, "Show Labels", group=grp_visual)
show_entry_signals = input.bool(true, "Show Entry Signals", group=grp_visual)

//=============================================================================
// FUNCTIONS
//=============================================================================

swing_high(len) =>
    ta.pivothigh(high, len, len)

swing_low(len) =>
    ta.pivotlow(low, len, len)

is_bull_fvg() =>
    low > high[2]

is_bear_fvg() =>
    high < low[2]

is_cisd_bullish() =>
    body = close - open
    range_size = high - low
    body_ratio = range_size > 0 ? body / range_size : 0
    prev_bearish = close[1] < open[1] and close[2] < open[2]
    body > 0 and body_ratio > 0.6 and prev_bearish

is_cisd_bearish() =>
    body = open - close
    range_size = high - low
    body_ratio = range_size > 0 ? body / range_size : 0
    prev_bullish = close[1] > open[1] and close[2] > open[2]
    body > 0 and body_ratio > 0.6 and prev_bullish

//=============================================================================
// HTF DATA
//=============================================================================

[htf_high, htf_low, htf_high2, htf_low2] = request.security(syminfo.tickerid, tf_htf_fvg, [high, low, high[2], low[2]])

//=============================================================================
// LIQUIDITY DETECTION
//=============================================================================

var float[] bsl_levels = array.new_float()
var float[] ssl_levels = array.new_float()

sh = swing_high(swing_length)
sl = swing_low(swing_length)

if not na(sh)
    array.push(bsl_levels, sh)
    if array.size(bsl_levels) > liquidity_lookback
        array.shift(bsl_levels)

if not na(sl)
    array.push(ssl_levels, sl)
    if array.size(ssl_levels) > liquidity_lookback
        array.shift(ssl_levels)

// Liquidity Sweep Detection
bsl_sweep = false
ssl_sweep = false

if array.size(bsl_levels) > 0
    for i = 0 to array.size(bsl_levels) - 1
        level = array.get(bsl_levels, i)
        if high > level and close < level
            bsl_sweep := true
            break

if array.size(ssl_levels) > 0
    for i = 0 to array.size(ssl_levels) - 1
        level = array.get(ssl_levels, i)
        if low < level and close > level
            ssl_sweep := true
            break

//=============================================================================
// FVG DETECTION
//=============================================================================

bull_fvg = is_bull_fvg()
bear_fvg = is_bear_fvg()
fvg_min_points = min_fvg_size * syminfo.mintick

var bool[] fvg_is_bull = array.new_bool()
var float[] fvg_tops = array.new_float()
var float[] fvg_bottoms = array.new_float()
var int[] fvg_start_bars = array.new_int()

if bull_fvg and (low - high[2]) >= fvg_min_points
    array.push(fvg_is_bull, true)
    array.push(fvg_tops, low)
    array.push(fvg_bottoms, high[2])
    array.push(fvg_start_bars, bar_index - 2)
    
if bear_fvg and (low[2] - high) >= fvg_min_points
    array.push(fvg_is_bull, false)
    array.push(fvg_tops, low[2])
    array.push(fvg_bottoms, high)
    array.push(fvg_start_bars, bar_index - 2)

//=============================================================================
// INVERSION FVG DETECTION
//=============================================================================

var bool ifvg_bull_signal = false
var bool ifvg_bear_signal = false
var float ifvg_entry = na
var float ifvg_sl = na

ifvg_bull_signal := false
ifvg_bear_signal := false

if array.size(fvg_is_bull) > 0
    for i = array.size(fvg_is_bull) - 1 to 0
        if i >= array.size(fvg_is_bull)
            continue
            
        is_bull = array.get(fvg_is_bull, i)
        fvg_top = array.get(fvg_tops, i)
        fvg_bottom = array.get(fvg_bottoms, i)
        start_bar = array.get(fvg_start_bars, i)
        
        if bar_index - start_bar > ifvg_lookback
            array.remove(fvg_is_bull, i)
            array.remove(fvg_tops, i)
            array.remove(fvg_bottoms, i)
            array.remove(fvg_start_bars, i)
            continue
        
        if not is_bull and close > fvg_top and close[1] <= fvg_top
            ifvg_bull_signal := true
            ifvg_entry := fvg_top
            ifvg_sl := fvg_bottom
            array.remove(fvg_is_bull, i)
            array.remove(fvg_tops, i)
            array.remove(fvg_bottoms, i)
            array.remove(fvg_start_bars, i)
            break
            
        if is_bull and close < fvg_bottom and close[1] >= fvg_bottom
            ifvg_bear_signal := true
            ifvg_entry := fvg_bottom
            ifvg_sl := fvg_top
            array.remove(fvg_is_bull, i)
            array.remove(fvg_tops, i)
            array.remove(fvg_bottoms, i)
            array.remove(fvg_start_bars, i)
            break

//=============================================================================
// CISD & SETUP DETECTION
//=============================================================================

cisd_bull = is_cisd_bullish()
cisd_bear = is_cisd_bearish()

var bool recent_ssl_sweep = false
var bool recent_bsl_sweep = false
var bool recent_htf_bull_fvg = false
var bool recent_htf_bear_fvg = false
var int sweep_bar = 0
var int htf_fvg_bar = 0

if ssl_sweep
    recent_ssl_sweep := true
    sweep_bar := bar_index
    
if bsl_sweep
    recent_bsl_sweep := true
    sweep_bar := bar_index

if bar_index - sweep_bar > 50
    recent_ssl_sweep := false
    recent_bsl_sweep := false

htf_bull_fvg = htf_low > htf_high2
htf_bear_fvg = htf_high < htf_low2

if htf_bull_fvg
    recent_htf_bull_fvg := true
    htf_fvg_bar := bar_index
    
if htf_bear_fvg
    recent_htf_bear_fvg := true
    htf_fvg_bar := bar_index

if bar_index - htf_fvg_bar > 50
    recent_htf_bull_fvg := false
    recent_htf_bear_fvg := false

full_long_setup = recent_ssl_sweep and recent_htf_bull_fvg and ifvg_bull_signal and cisd_bull
full_short_setup = recent_bsl_sweep and recent_htf_bear_fvg and ifvg_bear_signal and cisd_bear

//=============================================================================
// PLOTTING - ALL PLOTSHAPE AT GLOBAL SCOPE
//=============================================================================

// Liquidity Sweep markers
plotshape(ssl_sweep and show_labels, title="SSL Sweep", location=location.belowbar, style=shape.triangleup, size=size.small, color=col_sweep, text="SSL")
plotshape(bsl_sweep and show_labels, title="BSL Sweep", location=location.abovebar, style=shape.triangledown, size=size.small, color=col_sweep, text="BSL")

// CISD markers - GLOBAL SCOPE
plotshape(show_cisd and cisd_bull, title="CISD Bull", location=location.belowbar, style=shape.diamond, size=size.tiny, color=color.lime, text="CISD")
plotshape(show_cisd and cisd_bear, title="CISD Bear", location=location.abovebar, style=shape.diamond, size=size.tiny, color=color.fuchsia, text="CISD")

// Full Setup Entry Signals - GLOBAL SCOPE
plotshape(show_entry_signals and full_long_setup, title="LONG Setup", location=location.belowbar, style=shape.labelup, size=size.large, color=color.green, text="LONG", textcolor=color.white)
plotshape(show_entry_signals and full_short_setup, title="SHORT Setup", location=location.abovebar, style=shape.labeldown, size=size.large, color=color.red, text="SHORT", textcolor=color.white)

// Background for setups
bgcolor(full_long_setup ? color.new(color.green, 90) : na, title="Long BG")
bgcolor(full_short_setup ? color.new(color.red, 90) : na, title="Short BG")

//=============================================================================
// BOXES AND LINES (inside if blocks is OK for these)
//=============================================================================

if show_liquidity and barstate.islast
    if array.size(bsl_levels) > 0
        for i = 0 to math.min(4, array.size(bsl_levels) - 1)
            lvl = array.get(bsl_levels, array.size(bsl_levels) - 1 - i)
            line.new(bar_index - 15, lvl, bar_index, lvl, color=col_bsl, style=line.style_dashed)
    
    if array.size(ssl_levels) > 0
        for i = 0 to math.min(4, array.size(ssl_levels) - 1)
            lvl = array.get(ssl_levels, array.size(ssl_levels) - 1 - i)
            line.new(bar_index - 15, lvl, bar_index, lvl, color=col_ssl, style=line.style_dashed)

if show_htf_fvg and htf_bull_fvg
    box.new(bar_index - 3, htf_low, bar_index, htf_high2, bgcolor=col_bull_fvg, border_color=color.teal)

if show_htf_fvg and htf_bear_fvg
    box.new(bar_index - 3, htf_low2, bar_index, htf_high, bgcolor=col_bear_fvg, border_color=color.maroon)

if show_ifvg and ifvg_bull_signal
    box.new(bar_index - 2, ifvg_sl, bar_index + 5, ifvg_entry, bgcolor=col_bull_ifvg, border_color=color.green, border_width=2)

if show_ifvg and ifvg_bear_signal
    box.new(bar_index - 2, ifvg_entry, bar_index + 5, ifvg_sl, bgcolor=col_bear_ifvg, border_color=color.red, border_width=2)

//=============================================================================
// ALERTS
//=============================================================================

alertcondition(ssl_sweep, title="SSL Sweep", message="SSL Sweep on {{ticker}}")
alertcondition(bsl_sweep, title="BSL Sweep", message="BSL Sweep on {{ticker}}")
alertcondition(htf_bull_fvg, title="HTF Bull FVG", message="Bullish HTF FVG on {{ticker}}")
alertcondition(htf_bear_fvg, title="HTF Bear FVG", message="Bearish HTF FVG on {{ticker}}")
alertcondition(ifvg_bull_signal, title="Bullish iFVG", message="Bullish iFVG on {{ticker}}")
alertcondition(ifvg_bear_signal, title="Bearish iFVG", message="Bearish iFVG on {{ticker}}")
alertcondition(full_long_setup, title="FULL LONG", message="FULL LONG SETUP on {{ticker}}")
alertcondition(full_short_setup, title="FULL SHORT", message="FULL SHORT SETUP on {{ticker}}")

//=============================================================================
// INFO TABLE
//=============================================================================

var table tbl = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80))

if barstate.islast
    table.cell(tbl, 0, 0, "iFVG Strategy", text_color=color.white)
    table.cell(tbl, 1, 0, "Status", text_color=color.white)
    table.cell(tbl, 0, 1, "SSL Sweep", text_color=color.gray)
    table.cell(tbl, 1, 1, recent_ssl_sweep ? "YES" : "-", text_color=recent_ssl_sweep ? color.green : color.gray)
    table.cell(tbl, 0, 2, "BSL Sweep", text_color=color.gray)
    table.cell(tbl, 1, 2, recent_bsl_sweep ? "YES" : "-", text_color=recent_bsl_sweep ? color.red : color.gray)
    table.cell(tbl, 0, 3, "HTF Bull FVG", text_color=color.gray)
    table.cell(tbl, 1, 3, recent_htf_bull_fvg ? "YES" : "-", text_color=recent_htf_bull_fvg ? color.green : color.gray)
    table.cell(tbl, 0, 4, "HTF Bear FVG", text_color=color.gray)
    table.cell(tbl, 1, 4, recent_htf_bear_fvg ? "YES" : "-", text_color=recent_htf_bear_fvg ? color.red : color.gray)
    table.cell(tbl, 0, 5, "CISD Bull", text_color=color.gray)
    table.cell(tbl, 1, 5, cisd_bull ? "YES" : "-", text_color=cisd_bull ? color.green : color.gray)
    table.cell(tbl, 0, 6, "CISD Bear", text_color=color.gray)
    table.cell(tbl, 1, 6, cisd_bear ? "YES" : "-", text_color=cisd_bear ? color.red : color.gray)
    table.cell(tbl, 0, 7, "SETUP", text_color=color.white)
    table.cell(tbl, 1, 7, full_long_setup ? "LONG" : full_short_setup ? "SHORT" : "-", text_color=full_long_setup ? color.green : full_short_setup ? color.red : color.gray)
