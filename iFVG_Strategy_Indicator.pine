//@version=6
indicator("iFVG Multi-Timeframe Strategy", shorttitle = "iFVG MTF Strategy", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
//Settings
//---------------------------------------------------------------------------------------------------------------------{

//Timeframe Settings
tf_liq      = input.timeframe("60", title = "Liquidity TF", group = "Timeframe Settings", tooltip = "H1 or M15 for Liquidity Levels")
tf_htf      = input.timeframe("15", title = "HTF FVG Timeframe", group = "Timeframe Settings", tooltip = "M5, M15 or H1 for Higher TF FVG")

//Detection Settings
swingLen    = input.int(5, title = "Swing Length", minval = 2, maxval = 20, group = "Detection Settings")
minFvgSize  = input.float(5.0, title = "Min FVG Size (Points)", minval = 0.1, group = "Detection Settings")
ifvgLookback = input.int(50, title = "iFVG Lookback", minval = 10, maxval = 200, group = "Detection Settings")
maxLiqLevels = input.int(10, title = "Max Liquidity Levels", minval = 1, maxval = 20, group = "Detection Settings")

//Display Settings
showBsl     = input.bool(true, title = "Show BSL Levels", group = "Display Settings", inline = "BSL")
bslStyle    = input.string("───", title = "", options = ["───", "- - -", "· · ·"], group = "Display Settings", inline = "BSL")
showSsl     = input.bool(true, title = "Show SSL Levels", group = "Display Settings", inline = "SSL")
sslStyle    = input.string("───", title = "", options = ["───", "- - -", "· · ·"], group = "Display Settings", inline = "SSL")
showFvg     = input.bool(true, title = "Show FVG Zones", group = "Display Settings")
showIfvg    = input.bool(true, title = "Show iFVG Zones", group = "Display Settings")
showCisd    = input.bool(true, title = "Show CISD Signals", group = "Display Settings")
showSweep   = input.bool(true, title = "Show Sweep Signals", group = "Display Settings")
showSignals = input.bool(true, title = "Show Entry Signals", group = "Display Settings")
showTable   = input.bool(true, title = "Show Info Table", group = "Display Settings")

//Style
bullColor   = input.color(#089981, title = "Bull Color", group = "Style", inline = "Bull")
bullFill    = input.color(color.new(#089981,80), title = "Fill", group = "Style", inline = "Bull")
bearColor   = input.color(#f23645, title = "Bear Color", group = "Style", inline = "Bear")
bearFill    = input.color(color.new(#f23645,80), title = "Fill", group = "Style", inline = "Bear")
bslColor    = input.color(#089981, title = "BSL Color", group = "Style", inline = "Liq")
sslColor    = input.color(#f23645, title = "SSL Color", group = "Style", inline = "Liq")
sweepColor  = input.color(color.yellow, title = "Sweep Color", group = "Style")
liqLineWidth = input.int(1, title = "Liquidity Line Width", minval = 1, maxval = 4, group = "Style")

invis = color.rgb(0,0,0,100)

//---------------------------------------------------------------------------------------------------------------------}
//Functions
//---------------------------------------------------------------------------------------------------------------------{

getLineStyle(_style) =>
    switch _style
        "───" => line.style_solid
        "- - -" => line.style_dashed
        "· · ·" => line.style_dotted
        => line.style_solid

isBullFvg() => low > high[2]
isBearFvg() => high < low[2]

isCisdBull() =>
    body = close - open
    rangeSize = high - low
    bodyRatio = rangeSize > 0 ? body / rangeSize : 0
    prevBearish = close[1] < open[1] and close[2] < open[2]
    body > 0 and bodyRatio > 0.6 and prevBearish

isCisdBear() =>
    body = open - close
    rangeSize = high - low
    bodyRatio = rangeSize > 0 ? body / rangeSize : 0
    prevBullish = close[1] > open[1] and close[2] > open[2]
    body > 0 and bodyRatio > 0.6 and prevBullish

//---------------------------------------------------------------------------------------------------------------------}
//Variables
//---------------------------------------------------------------------------------------------------------------------{

var float[] fvgTops = array.new_float()
var float[] fvgBottoms = array.new_float()
var int[] fvgTimes = array.new_int()
var bool[] fvgIsBull = array.new_bool()

var float[] bslPrices = array.new_float()
var int[] bslTimes = array.new_int()
var line[] bslLines = array.new_line()
var label[] bslLabels = array.new_label()

var float[] sslPrices = array.new_float()
var int[] sslTimes = array.new_int()
var line[] sslLines = array.new_line()
var label[] sslLabels = array.new_label()

var bool recentSslSweep    = false
var bool recentBslSweep    = false
var bool recentHtfBullFvg  = false
var bool recentHtfBearFvg  = false
var int sweepBar    = 0
var int htfFvgBar   = 0

//---------------------------------------------------------------------------------------------------------------------}
//HTF Data
//---------------------------------------------------------------------------------------------------------------------{

[htfHigh, htfLow, htfHigh2, htfLow2] = request.security(syminfo.tickerid, tf_htf, [high, low, high[2], low[2]])

htfBullFvg = htfLow > htfHigh2
htfBearFvg = htfHigh < htfLow2

//---------------------------------------------------------------------------------------------------------------------}
//HTF Liquidity Detection - Using TIME for fixed positioning
//---------------------------------------------------------------------------------------------------------------------{

//Get swing data from liquidity timeframe
[liqSwingHigh, liqSwingLow, liqTime] = request.security(syminfo.tickerid, tf_liq, [ta.pivothigh(high, swingLen, swingLen), ta.pivotlow(low, swingLen, swingLen), time[swingLen]])

//Detect new BSL level
newBsl = not na(liqSwingHigh) and (array.size(bslPrices) == 0 or liqSwingHigh != array.last(bslPrices))

//Detect new SSL level
newSsl = not na(liqSwingLow) and (array.size(sslPrices) == 0 or liqSwingLow != array.last(sslPrices))

//Add new BSL levels - FIXED with xloc.bar_time
if newBsl and barstate.isconfirmed and showBsl
    if array.size(bslLines) >= maxLiqLevels
        line.delete(array.shift(bslLines))
        label.delete(array.shift(bslLabels))
        array.shift(bslPrices)
        array.shift(bslTimes)
    
    array.push(bslPrices, liqSwingHigh)
    array.push(bslTimes, liqTime)
    
    //Create line with xloc.bar_time - FIXED to time, extends right
    newLine = line.new(liqTime, liqSwingHigh, time + 86400000, liqSwingHigh, 
                       xloc = xloc.bar_time, color = bslColor, style = getLineStyle(bslStyle), 
                       width = liqLineWidth, extend = extend.right)
    newLbl = label.new(liqTime, liqSwingHigh, text = "BSL", xloc = xloc.bar_time,
                       style = label.style_none, textcolor = bslColor, size = size.small)
    array.push(bslLines, newLine)
    array.push(bslLabels, newLbl)

//Add new SSL levels - FIXED with xloc.bar_time
if newSsl and barstate.isconfirmed and showSsl
    if array.size(sslLines) >= maxLiqLevels
        line.delete(array.shift(sslLines))
        label.delete(array.shift(sslLabels))
        array.shift(sslPrices)
        array.shift(sslTimes)
    
    array.push(sslPrices, liqSwingLow)
    array.push(sslTimes, liqTime)
    
    //Create line with xloc.bar_time - FIXED to time, extends right
    newLine = line.new(liqTime, liqSwingLow, time + 86400000, liqSwingLow, 
                       xloc = xloc.bar_time, color = sslColor, style = getLineStyle(sslStyle), 
                       width = liqLineWidth, extend = extend.right)
    newLbl = label.new(liqTime, liqSwingLow, text = "SSL", xloc = xloc.bar_time,
                       style = label.style_none, textcolor = sslColor, size = size.small)
    array.push(sslLines, newLine)
    array.push(sslLabels, newLbl)

//---------------------------------------------------------------------------------------------------------------------}
//Sweep Detection
//---------------------------------------------------------------------------------------------------------------------{

bslSweep = false
sslSweep = false

//BSL Sweep Detection
if array.size(bslPrices) > 0 and barstate.isconfirmed
    for i = array.size(bslPrices) - 1 to 0
        lvl = array.get(bslPrices, i)
        if high > lvl and close < lvl
            bslSweep := true
            //Mark swept - stop extending
            if i < array.size(bslLines)
                ln = array.get(bslLines, i)
                line.set_extend(ln, extend.none)
                line.set_x2(ln, time)
                line.set_style(ln, line.style_dotted)
            break

//SSL Sweep Detection
if array.size(sslPrices) > 0 and barstate.isconfirmed
    for i = array.size(sslPrices) - 1 to 0
        lvl = array.get(sslPrices, i)
        if low < lvl and close > lvl
            sslSweep := true
            //Mark swept - stop extending
            if i < array.size(sslLines)
                ln = array.get(sslLines, i)
                line.set_extend(ln, extend.none)
                line.set_x2(ln, time)
                line.set_style(ln, line.style_dotted)
            break

//---------------------------------------------------------------------------------------------------------------------}
//FVG Detection - FIXED with xloc.bar_time
//---------------------------------------------------------------------------------------------------------------------{

bullFvg = isBullFvg()
bearFvg = isBearFvg()
fvgMinPts = minFvgSize * syminfo.mintick

//Store new Bull FVGs
if bullFvg and (low - high[2]) >= fvgMinPts and barstate.isconfirmed
    array.push(fvgIsBull, true)
    array.push(fvgTops, low)
    array.push(fvgBottoms, high[2])
    array.push(fvgTimes, time[2])
    if showFvg
        box.new(time[2], low, time + 3600000, high[2], xloc = xloc.bar_time, 
                bgcolor = bullFill, border_color = bullColor)

//Store new Bear FVGs
if bearFvg and (low[2] - high) >= fvgMinPts and barstate.isconfirmed
    array.push(fvgIsBull, false)
    array.push(fvgTops, low[2])
    array.push(fvgBottoms, high)
    array.push(fvgTimes, time[2])
    if showFvg
        box.new(time[2], low[2], time + 3600000, high, xloc = xloc.bar_time, 
                bgcolor = bearFill, border_color = bearColor)

//---------------------------------------------------------------------------------------------------------------------}
//iFVG Detection
//---------------------------------------------------------------------------------------------------------------------{

ifvgBullSignal = false
ifvgBearSignal = false
var float ifvgEntry = na
var float ifvgSl = na

if array.size(fvgIsBull) > 0 and barstate.isconfirmed
    for i = array.size(fvgIsBull) - 1 to 0
        if i >= array.size(fvgIsBull)
            continue
            
        isBull = array.get(fvgIsBull, i)
        fvgTop = array.get(fvgTops, i)
        fvgBottom = array.get(fvgBottoms, i)
        fvgTime = array.get(fvgTimes, i)
        
        //Remove old FVGs (older than lookback bars worth of time)
        if time - fvgTime > ifvgLookback * timeframe.in_seconds(timeframe.period) * 1000
            array.remove(fvgIsBull, i)
            array.remove(fvgTops, i)
            array.remove(fvgBottoms, i)
            array.remove(fvgTimes, i)
            continue
        
        //Bullish iFVG
        if not isBull and close > fvgTop and close[1] <= fvgTop
            ifvgBullSignal := true
            ifvgEntry := fvgTop
            ifvgSl := fvgBottom
            if showIfvg
                box.new(fvgTime, fvgBottom, time + 3600000, fvgTop, xloc = xloc.bar_time,
                        bgcolor = bullFill, border_color = bullColor, border_width = 2)
                label.new(time, fvgTop, text = "iFVG", xloc = xloc.bar_time,
                          style = label.style_label_left, color = invis, textcolor = bullColor, size = size.small)
            array.remove(fvgIsBull, i)
            array.remove(fvgTops, i)
            array.remove(fvgBottoms, i)
            array.remove(fvgTimes, i)
            break
            
        //Bearish iFVG
        if isBull and close < fvgBottom and close[1] >= fvgBottom
            ifvgBearSignal := true
            ifvgEntry := fvgBottom
            ifvgSl := fvgTop
            if showIfvg
                box.new(fvgTime, fvgBottom, time + 3600000, fvgTop, xloc = xloc.bar_time,
                        bgcolor = bearFill, border_color = bearColor, border_width = 2)
                label.new(time, fvgBottom, text = "iFVG", xloc = xloc.bar_time,
                          style = label.style_label_left, color = invis, textcolor = bearColor, size = size.small)
            array.remove(fvgIsBull, i)
            array.remove(fvgTops, i)
            array.remove(fvgBottoms, i)
            array.remove(fvgTimes, i)
            break

//---------------------------------------------------------------------------------------------------------------------}
//CISD Detection
//---------------------------------------------------------------------------------------------------------------------{

cisdBull = isCisdBull() and barstate.isconfirmed
cisdBear = isCisdBear() and barstate.isconfirmed

//---------------------------------------------------------------------------------------------------------------------}
//Setup Tracking
//---------------------------------------------------------------------------------------------------------------------{

if sslSweep
    recentSslSweep := true
    sweepBar := bar_index
    
if bslSweep
    recentBslSweep := true
    sweepBar := bar_index

if bar_index - sweepBar > 50
    recentSslSweep := false
    recentBslSweep := false

if htfBullFvg and barstate.isconfirmed
    recentHtfBullFvg := true
    htfFvgBar := bar_index
    
if htfBearFvg and barstate.isconfirmed
    recentHtfBearFvg := true
    htfFvgBar := bar_index

if bar_index - htfFvgBar > 50
    recentHtfBullFvg := false
    recentHtfBearFvg := false

fullLongSetup  = recentSslSweep and recentHtfBullFvg and ifvgBullSignal and cisdBull
fullShortSetup = recentBslSweep and recentHtfBearFvg and ifvgBearSignal and cisdBear

//---------------------------------------------------------------------------------------------------------------------}
//Display - plotshape is always fixed to bars
//---------------------------------------------------------------------------------------------------------------------{

plotshape(sslSweep and showSweep, title = "SSL Sweep", location = location.belowbar, style = shape.triangleup, size = size.small, color = sweepColor, text = "SWEEP", textcolor = sweepColor)
plotshape(bslSweep and showSweep, title = "BSL Sweep", location = location.abovebar, style = shape.triangledown, size = size.small, color = sweepColor, text = "SWEEP", textcolor = sweepColor)

plotshape(showCisd and cisdBull, title = "CISD Bull", location = location.belowbar, style = shape.diamond, size = size.tiny, color = color.lime, text = "CISD", textcolor = color.lime)
plotshape(showCisd and cisdBear, title = "CISD Bear", location = location.abovebar, style = shape.diamond, size = size.tiny, color = color.fuchsia, text = "CISD", textcolor = color.fuchsia)

plotshape(showSignals and fullLongSetup, title = "LONG Setup", location = location.belowbar, style = shape.labelup, size = size.large, color = color.green, text = "LONG", textcolor = color.white)
plotshape(showSignals and fullShortSetup, title = "SHORT Setup", location = location.abovebar, style = shape.labeldown, size = size.large, color = color.red, text = "SHORT", textcolor = color.white)

bgcolor(fullLongSetup ? color.new(color.green, 90) : na, title = "Long BG")
bgcolor(fullShortSetup ? color.new(color.red, 90) : na, title = "Short BG")

//---------------------------------------------------------------------------------------------------------------------}
//Info Table
//---------------------------------------------------------------------------------------------------------------------{

var table infoTbl = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 80), border_width = 1)

if barstate.islast and showTable
    infoTbl.cell(0, 0, "iFVG Strategy", text_color = color.white, text_size = size.normal)
    infoTbl.cell(1, 0, "Status", text_color = color.white, text_size = size.normal)
    infoTbl.cell(0, 1, "SSL Sweep", text_color = color.gray, text_size = size.small)
    infoTbl.cell(1, 1, recentSslSweep ? "YES" : "-", text_color = recentSslSweep ? color.green : color.gray, text_size = size.small)
    infoTbl.cell(0, 2, "BSL Sweep", text_color = color.gray, text_size = size.small)
    infoTbl.cell(1, 2, recentBslSweep ? "YES" : "-", text_color = recentBslSweep ? color.red : color.gray, text_size = size.small)
    infoTbl.cell(0, 3, "HTF Bull FVG", text_color = color.gray, text_size = size.small)
    infoTbl.cell(1, 3, recentHtfBullFvg ? "YES" : "-", text_color = recentHtfBullFvg ? color.green : color.gray, text_size = size.small)
    infoTbl.cell(0, 4, "HTF Bear FVG", text_color = color.gray, text_size = size.small)
    infoTbl.cell(1, 4, recentHtfBearFvg ? "YES" : "-", text_color = recentHtfBearFvg ? color.red : color.gray, text_size = size.small)
    infoTbl.cell(0, 5, "iFVG Bull", text_color = color.gray, text_size = size.small)
    infoTbl.cell(1, 5, ifvgBullSignal ? "YES" : "-", text_color = ifvgBullSignal ? color.green : color.gray, text_size = size.small)
    infoTbl.cell(0, 6, "iFVG Bear", text_color = color.gray, text_size = size.small)
    infoTbl.cell(1, 6, ifvgBearSignal ? "YES" : "-", text_color = ifvgBearSignal ? color.red : color.gray, text_size = size.small)
    infoTbl.cell(0, 7, "SETUP", text_color = color.white, text_size = size.normal)
    setupTxt = fullLongSetup ? "LONG" : fullShortSetup ? "SHORT" : "-"
    setupCol = fullLongSetup ? color.green : fullShortSetup ? color.red : color.gray
    infoTbl.cell(1, 7, setupTxt, text_color = setupCol, text_size = size.normal)

//---------------------------------------------------------------------------------------------------------------------}
//Alerts
//---------------------------------------------------------------------------------------------------------------------{

alertcondition(sslSweep, title = "SSL Sweep", message = "SSL Sweep on {{ticker}}")
alertcondition(bslSweep, title = "BSL Sweep", message = "BSL Sweep on {{ticker}}")
alertcondition(ifvgBullSignal, title = "Bullish iFVG", message = "Bullish iFVG on {{ticker}}")
alertcondition(ifvgBearSignal, title = "Bearish iFVG", message = "Bearish iFVG on {{ticker}}")
alertcondition(fullLongSetup, title = "FULL LONG", message = "FULL LONG SETUP on {{ticker}}")
alertcondition(fullShortSetup, title = "FULL SHORT", message = "FULL SHORT SETUP on {{ticker}}")

//---------------------------------------------------------------------------------------------------------------------}
