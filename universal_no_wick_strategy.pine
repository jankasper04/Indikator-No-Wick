//@version=5
strategy("Universal No Wick Market Structure Strategy", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ==================== TREND FILTER METHOD ====================
filterSettings = "Trend Filter Settings"
trendMethod = input.string("Market Structure", "Trend Filter Method", options=["Market Structure", "EMA"], group=filterSettings, display=display.data_window)
emaLength = input.int(50, "EMA Length", group=filterSettings, minval=5, display=display.data_window)

// ==================== MARKET STRUCTURE INPUTS ====================
msSettings = "Market Structure Settings"
zigzag_len = input.int(9, "ZigZag Length", group=msSettings, minval=3, display=display.data_window)
show_zigzag = input.bool(true, "Show ZigZag", group=msSettings, display=display.data_window)
show_hh_ll = input.bool(true, "Show HH/HL/LH/LL Labels", group=msSettings, display=display.data_window)
show_choch = input.bool(true, "Show Change of Character (ChoCH)", group=msSettings, display=display.data_window)
show_bos = input.bool(true, "Show Break of Structure (BOS)", group=msSettings, display=display.data_window)

// ==================== NO WICK INPUTS ====================
nwSettings = "No Wick Candle Settings"
show_compensation = input.bool(true, "Show Compensation Lines", group=nwSettings, display=display.data_window)
show_compensation_label = input.bool(true, "Show Compensation Label", group=nwSettings, display=display.data_window)
compensationBars = input.int(20, "Compensation Line Length (bars)", group=nwSettings, minval=1, display=display.data_window)
colorNoWickCandles = input.bool(true, "Color No-Wick Candles", group=nwSettings, display=display.data_window)
bullishNoWickColor = input.color(color.lime, "Bullish No-Wick Color", group=nwSettings, display=display.data_window)
bearishNoWickColor = input.color(color.fuchsia, "Bearish No-Wick Color", group=nwSettings, display=display.data_window)

// ==================== HTF MARKER INPUTS ====================
htfSettings = "HTF Marker Settings"
show_htf_marker = input.bool(true, "Show HTF Start Marker", group=htfSettings, display=display.data_window)
show_30m_marker = input.bool(true, "Mark 30min Candle Start", group=htfSettings, display=display.data_window)
color_30m = input.color(color.yellow, "30min Marker Color", group=htfSettings, display=display.data_window)
show_1h_marker = input.bool(true, "Mark 1h Candle Start", group=htfSettings, display=display.data_window)
color_1h = input.color(color.orange, "1h Marker Color", group=htfSettings, display=display.data_window)
show_4h_marker = input.bool(true, "Mark 4h Candle Start", group=htfSettings, display=display.data_window)
color_4h = input.color(color.aqua, "4h Marker Color", group=htfSettings, display=display.data_window)

// ==================== TRADE INPUTS ====================
tradeSettings = "Trade Settings"
contracts = input.int(1, "Number of Contracts", minval=1, group=tradeSettings, display=display.data_window)
cancelAfter = input.int(10, "Cancel Order After X Candles", minval=1, group=tradeSettings, display=display.data_window)
slMethod = input.string("ATR", "Stop Loss Method", options=["ATR", "Structure (Last High/Low)"], group=tradeSettings, display=display.data_window)
atrMultiplier = input.float(1.5, "ATR Multiplier for SL", minval=0.1, step=0.1, group=tradeSettings, display=display.data_window, tooltip="Used when SL Method = ATR")
structureBuffer = input.float(0.5, "Structure Buffer (ATR)", minval=0.0, step=0.1, group=tradeSettings, display=display.data_window, tooltip="Buffer in ATR units added to structure level. Used when SL Method = Structure")
tpMultiplier = input.float(2.0, "TP (x SL Distance)", minval=0.1, step=0.1, group=tradeSettings, display=display.data_window)
showHistoricalTrades = input.bool(true, "Show Historical Entry/SL/TP Lines", group=tradeSettings, display=display.data_window)

// ==================== SESSION INPUTS ====================
sessionSettings = "Session Settings"
useSession = input.bool(false, "Use Session Filter", group=sessionSettings, display=display.data_window)
tradingSession = input.session("0200-1600", "Trading Session", group=sessionSettings, display=display.data_window)
sessionTimezone = input.string("America/New_York", "Session Timezone", options=["America/New_York", "America/Chicago", "America/Los_Angeles", "America/Toronto", "Europe/London", "Europe/Berlin", "Europe/Paris", "Europe/Zurich", "Europe/Moscow", "Asia/Tokyo", "Asia/Hong_Kong", "Asia/Shanghai", "Asia/Singapore", "Asia/Dubai", "Asia/Kolkata", "Australia/Sydney", "Pacific/Auckland", "UTC"], group=sessionSettings, display=display.data_window)

// ==================== VISUAL INPUTS ====================
visualSettings = "Visual Settings"
showZones = input.bool(true, "Show Entry/SL Zones", group=visualSettings, display=display.data_window)
zoneTransparency = input.int(80, "Zone Transparency", minval=0, maxval=100, group=visualSettings, display=display.data_window)
showInfoTable = input.bool(true, "Show Info Table", group=visualSettings, display=display.data_window)

// ==================== STATISTICS DASHBOARD ====================
statsSettings = "Statistics Dashboard"
showStatsDashboard = input.bool(true, "Show No-Wick Statistics Dashboard", group=statsSettings, display=display.data_window)
statsLookback = input.int(100, "Lookback Period (Candles)", group=statsSettings, minval=10, maxval=500, display=display.data_window)
statsDashboardPos = input.string("Bottom Left", "Dashboard Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group=statsSettings, display=display.data_window)

// ==================== EMA CALCULATION ====================
ema = ta.ema(close, emaLength)
isEmaUptrend = close > ema
isEmaDowntrend = close < ema

// ==================== MARKET STRUCTURE CALCULATION ====================
var float[] high_points_arr = array.new_float(5)
var int[] high_index_arr = array.new_int(5)
var float[] low_points_arr = array.new_float(5)
var int[] low_index_arr = array.new_int(5)

to_up = high >= ta.highest(zigzag_len)
to_down = low <= ta.lowest(zigzag_len)

var int zigzagTrend = 1
zigzagTrend := zigzagTrend == 1 and to_down ? -1 : zigzagTrend == -1 and to_up ? 1 : zigzagTrend

last_trend_up_since = ta.barssince(to_up[1])
low_val = ta.lowest(nz(last_trend_up_since > 0 ? last_trend_up_since : 1, 1))
low_index = bar_index - ta.barssince(low_val == low)

last_trend_down_since = ta.barssince(to_down[1])
high_val = ta.highest(nz(last_trend_down_since > 0 ? last_trend_down_since : 1, 1))
high_index = bar_index - ta.barssince(high_val == high)

if ta.change(zigzagTrend) != 0
    if zigzagTrend == 1
        array.push(low_points_arr, low_val)
        array.push(low_index_arr, low_index)
    if zigzagTrend == -1
        array.push(high_points_arr, high_val)
        array.push(high_index_arr, high_index)

f_get_high(ind) =>
    [array.get(high_points_arr, math.max(0, array.size(high_points_arr) - 1 - ind)), array.get(high_index_arr, math.max(0, array.size(high_index_arr) - 1 - ind))]

f_get_low(ind) =>
    [array.get(low_points_arr, math.max(0, array.size(low_points_arr) - 1 - ind)), array.get(low_index_arr, math.max(0, array.size(low_index_arr) - 1 - ind))]

[h0, h0i] = f_get_high(0)
[h1, h1i] = f_get_high(1)
[l0, l0i] = f_get_low(0)
[l1, l1i] = f_get_low(1)

// Draw ZigZag
if ta.change(zigzagTrend) != 0 and show_zigzag and trendMethod == "Market Structure"
    if zigzagTrend == 1
        line.new(h0i, h0, l0i, l0, color=color.gray, width=1)
    if zigzagTrend == -1
        line.new(l0i, l0, h0i, h0, color=color.gray, width=1)

// ==================== SWING POINT CLASSIFICATION ====================
isHigherHigh = h0 > h1
isHigherLow = l0 > l1
isLowerHigh = h0 < h1
isLowerLow = l0 < l1

// ==================== MARKET STRUCTURE STATE ====================
var int marketStructure = 0

if marketStructure == 0
    if isHigherHigh and isHigherLow
        marketStructure := 1
    else if isLowerHigh and isLowerLow
        marketStructure := -1

// ==================== ChoCH & BOS TRACKING ====================
var float lastChochLevel = na
var int lastChochBar = na
var float lastBosLevel = na
var int lastBosBar = na

var bool chochBullishDone = false
var bool chochBearishDone = false
var bool bosBullishDone = false
var bool bosBearishDone = false

chochBullish = false
chochBearish = false
bosBullish = false
bosBearish = false

// ChoCH Detection
if close > h0 and isLowerHigh and not chochBullishDone
    chochBullish := true
    chochBullishDone := true
    chochBearishDone := false
    bosBullishDone := false
    bosBearishDone := false
    lastChochLevel := h0
    lastChochBar := h0i
    marketStructure := 1

if close < l0 and isHigherLow and not chochBearishDone
    chochBearish := true
    chochBearishDone := true
    chochBullishDone := false
    bosBullishDone := false
    bosBearishDone := false
    lastChochLevel := l0
    lastChochBar := l0i
    marketStructure := -1

// BOS Detection
if close > h0 and isHigherHigh and marketStructure == 1 and not bosBullishDone and not chochBullish
    bosBullish := true
    bosBullishDone := true
    lastBosLevel := h0
    lastBosBar := h0i

if close < l0 and isLowerLow and marketStructure == -1 and not bosBearishDone and not chochBearish
    bosBearish := true
    bosBearishDone := true
    lastBosLevel := l0
    lastBosBar := l0i

if ta.change(zigzagTrend) != 0
    chochBullishDone := false
    chochBearishDone := false
    bosBullishDone := false
    bosBearishDone := false

// ==================== FINAL STRUCTURE STATUS ====================
isMSBullishStructure = marketStructure == 1
isMSBearishStructure = marketStructure == -1

isBullishStructure = trendMethod == "Market Structure" ? isMSBullishStructure : isEmaUptrend
isBearishStructure = trendMethod == "Market Structure" ? isMSBearishStructure : isEmaDowntrend

// ==================== HH/HL/LH/LL LABELS ====================
if ta.change(zigzagTrend) != 0 and show_hh_ll and trendMethod == "Market Structure"
    if zigzagTrend == -1
        labelText = isHigherHigh ? "HH" : "LH"
        labelColor = isHigherHigh ? color.green : color.red
        label.new(h0i, h0, labelText, color=color.new(color.black, 100), style=label.style_label_down, textcolor=labelColor, size=size.small)
    if zigzagTrend == 1
        labelText = isHigherLow ? "HL" : "LL"
        labelColor = isHigherLow ? color.green : color.red
        label.new(l0i, l0, labelText, color=color.new(color.black, 100), style=label.style_label_up, textcolor=labelColor, size=size.small)

// ==================== ChoCH VISUALIZATION ====================
if chochBullish and show_choch and trendMethod == "Market Structure"
    line.new(lastChochBar, lastChochLevel, bar_index, lastChochLevel, color=color.green, width=2, style=line.style_solid)
    label.new(bar_index, lastChochLevel, "ChoCH ↑", color=color.new(color.green, 70), style=label.style_label_up, textcolor=color.white, size=size.small)

if chochBearish and show_choch and trendMethod == "Market Structure"
    line.new(lastChochBar, lastChochLevel, bar_index, lastChochLevel, color=color.red, width=2, style=line.style_solid)
    label.new(bar_index, lastChochLevel, "ChoCH ↓", color=color.new(color.red, 70), style=label.style_label_down, textcolor=color.white, size=size.small)

// ==================== BOS VISUALIZATION ====================
if bosBullish and show_bos and trendMethod == "Market Structure"
    line.new(lastBosBar, lastBosLevel, bar_index, lastBosLevel, color=color.teal, width=1, style=line.style_dashed)
    label.new(bar_index, lastBosLevel, "BOS ↑", color=color.new(color.teal, 70), style=label.style_label_down, textcolor=color.white, size=size.tiny)

if bosBearish and show_bos and trendMethod == "Market Structure"
    line.new(lastBosBar, lastBosLevel, bar_index, lastBosLevel, color=color.orange, width=1, style=line.style_dashed)
    label.new(bar_index, lastBosLevel, "BOS ↓", color=color.new(color.orange, 70), style=label.style_label_up, textcolor=color.white, size=size.tiny)

// ==================== NO WICK CANDLE DETECTION ====================
bullishNoBottomWick = open == low and close > open
bearishNoTopWick = open == high and close < open
anyNoWick = bullishNoBottomWick or bearishNoTopWick

isBullishNoWick = bullishNoBottomWick and marketStructure == 1
isBearishNoWick = bearishNoTopWick and marketStructure == -1

// ==================== NO WICK STATISTICS CALCULATION ====================
// Get HTF data using request.security
[o15, h15, l15, c15] = request.security(syminfo.tickerid, "15", [open, high, low, close])
[o30, h30, l30, c30] = request.security(syminfo.tickerid, "30", [open, high, low, close])
[o60, h60, l60, c60] = request.security(syminfo.tickerid, "60", [open, high, low, close])
[o240, h240, l240, c240] = request.security(syminfo.tickerid, "240", [open, high, low, close])

// Calculate no-wick conditions for each timeframe
bull15 = o15 == l15 and c15 > o15
bear15 = o15 == h15 and c15 < o15
bull30 = o30 == l30 and c30 > o30
bear30 = o30 == h30 and c30 < o30
bull60 = o60 == l60 and c60 > o60
bear60 = o60 == h60 and c60 < o60
bull240 = o240 == l240 and c240 > o240
bear240 = o240 == h240 and c240 < o240

// Count using ta.cum for lookback period
bullCurrentVal = bullishNoBottomWick ? 1.0 : 0.0
bearCurrentVal = bearishNoTopWick ? 1.0 : 0.0
bull15Val = bull15 ? 1.0 : 0.0
bear15Val = bear15 ? 1.0 : 0.0
bull30Val = bull30 ? 1.0 : 0.0
bear30Val = bear30 ? 1.0 : 0.0
bull60Val = bull60 ? 1.0 : 0.0
bear60Val = bear60 ? 1.0 : 0.0
bull240Val = bull240 ? 1.0 : 0.0
bear240Val = bear240 ? 1.0 : 0.0

// Use ta.sma * length for sum calculation (works better with inputs)
countBullCurrent = ta.sma(bullCurrentVal, statsLookback) * statsLookback
countBearCurrent = ta.sma(bearCurrentVal, statsLookback) * statsLookback
countBull15 = ta.sma(bull15Val, statsLookback) * statsLookback
countBear15 = ta.sma(bear15Val, statsLookback) * statsLookback
countBull30 = ta.sma(bull30Val, statsLookback) * statsLookback
countBear30 = ta.sma(bear30Val, statsLookback) * statsLookback
countBull60 = ta.sma(bull60Val, statsLookback) * statsLookback
countBear60 = ta.sma(bear60Val, statsLookback) * statsLookback
countBull240 = ta.sma(bull240Val, statsLookback) * statsLookback
countBear240 = ta.sma(bear240Val, statsLookback) * statsLookback

// Calculate percentages
countTotalCurrent = countBullCurrent + countBearCurrent
pctBullCurrent = (countBullCurrent / statsLookback) * 100
pctBearCurrent = (countBearCurrent / statsLookback) * 100
pctCurrent = pctBullCurrent + pctBearCurrent

pctBull15 = (countBull15 / statsLookback) * 100
pctBear15 = (countBear15 / statsLookback) * 100
pct15 = pctBull15 + pctBear15

pctBull30 = (countBull30 / statsLookback) * 100
pctBear30 = (countBear30 / statsLookback) * 100
pct30 = pctBull30 + pctBear30

pctBull60 = (countBull60 / statsLookback) * 100
pctBear60 = (countBear60 / statsLookback) * 100
pct60 = pctBull60 + pctBear60

pctBull240 = (countBull240 / statsLookback) * 100
pctBear240 = (countBear240 / statsLookback) * 100
pct240 = pctBull240 + pctBear240

// ==================== HTF START DETECTION ====================
is30mStart = ta.change(time("30")) != 0
is1hStart = ta.change(time("60")) != 0
is4hStart = ta.change(time("240")) != 0

htfPriority = is4hStart and show_4h_marker ? 3 : is1hStart and show_1h_marker ? 2 : is30mStart and show_30m_marker ? 1 : 0

bullishNoWick30m = bullishNoBottomWick and is30mStart and show_30m_marker and htfPriority == 1
bearishNoWick30m = bearishNoTopWick and is30mStart and show_30m_marker and htfPriority == 1

bullishNoWick1h = bullishNoBottomWick and is1hStart and show_1h_marker and htfPriority == 2
bearishNoWick1h = bearishNoTopWick and is1hStart and show_1h_marker and htfPriority == 2

bullishNoWick4h = bullishNoBottomWick and is4hStart and show_4h_marker
bearishNoWick4h = bearishNoTopWick and is4hStart and show_4h_marker

// ==================== COLOR NO-WICK CANDLES ====================
noWickColor = bullishNoBottomWick ? bullishNoWickColor : bearishNoTopWick ? bearishNoWickColor : na
barcolor(colorNoWickCandles and (bullishNoBottomWick or bearishNoTopWick) ? noWickColor : na)

// ==================== COMPENSATION LINES ====================
if (bullishNoBottomWick or bearishNoTopWick) and show_compensation
    compColor = color.rgb(255, 174, 53)
    line.new(bar_index, open, bar_index + compensationBars, open, color=compColor, width=1, style=line.style_solid)
    if show_compensation_label
        label.new(bar_index + compensationBars + 1, open, "Compensation", style=label.style_label_left, color=compColor, textcolor=color.white, size=size.tiny)

// ==================== ATR ====================
atr = ta.atr(14)
isInSession = useSession ? not na(time(timeframe.period, tradingSession, sessionTimezone)) : true

// ==================== STRATEGY VARIABLES ====================
var float longEntryPrice = na
var float longStopLoss = na
var float longTakeProfit = na
var int longOrderBars = 0
var bool longPending = false
var int longEntryBar = na

var float shortEntryPrice = na
var float shortStopLoss = na
var float shortTakeProfit = na
var int shortOrderBars = 0
var bool shortPending = false
var int shortEntryBar = na

var float signalAtr = na
var box entryBox = na
var box slBox = na

var float activeSL = na
var float activeTP = na
var float activeEntry = na
var bool inLong = false
var bool inShort = false

// ==================== CANCEL ORDERS ON STRUCTURE CHANGE ====================
if chochBullish and shortPending
    strategy.cancel("Short")
    shortPending := false
    shortEntryPrice := na
    if not na(entryBox)
        box.delete(entryBox)
        entryBox := na
    if not na(slBox)
        box.delete(slBox)
        slBox := na

if chochBearish and longPending
    strategy.cancel("Long")
    longPending := false
    longEntryPrice := na
    if not na(entryBox)
        box.delete(entryBox)
        entryBox := na
    if not na(slBox)
        box.delete(slBox)
        slBox := na

// ==================== LONG SETUP ====================
canGoLong = marketStructure == 1 and isInSession and strategy.position_size == 0 and not longPending and not shortPending

if bullishNoBottomWick and canGoLong
    if not na(entryBox)
        box.delete(entryBox)
    if not na(slBox)
        box.delete(slBox)
    
    longEntryPrice := open
    signalAtr := atr
    
    // Calculate SL based on selected method
    if slMethod == "ATR"
        longStopLoss := longEntryPrice - (signalAtr * atrMultiplier)
    else // Structure (Last High/Low)
        longStopLoss := l0 - (signalAtr * structureBuffer)  // Below last structural low
    
    slDistance = longEntryPrice - longStopLoss
    longTakeProfit := longEntryPrice + (slDistance * tpMultiplier)
    longOrderBars := 0
    longPending := true
    longEntryBar := bar_index
    
    if showZones
        entryBox := box.new(bar_index, close, bar_index + cancelAfter, longEntryPrice, border_color=color.green, bgcolor=color.new(color.green, zoneTransparency), border_width=1)
        slBox := box.new(bar_index, longEntryPrice, bar_index + cancelAfter, longStopLoss, border_color=color.red, bgcolor=color.new(color.red, zoneTransparency), border_width=1)
    
    strategy.entry("Long", strategy.long, limit=longEntryPrice, qty=contracts)

// ==================== SHORT SETUP ====================
canGoShort = marketStructure == -1 and isInSession and strategy.position_size == 0 and not shortPending and not longPending

if bearishNoTopWick and canGoShort
    if not na(entryBox)
        box.delete(entryBox)
    if not na(slBox)
        box.delete(slBox)
    
    shortEntryPrice := open
    signalAtr := atr
    
    // Calculate SL based on selected method
    if slMethod == "ATR"
        shortStopLoss := shortEntryPrice + (signalAtr * atrMultiplier)
    else // Structure (Last High/Low)
        shortStopLoss := h0 + (signalAtr * structureBuffer)  // Above last structural high
    
    slDistance = shortStopLoss - shortEntryPrice
    shortTakeProfit := shortEntryPrice - (slDistance * tpMultiplier)
    shortOrderBars := 0
    shortPending := true
    shortEntryBar := bar_index
    
    if showZones
        entryBox := box.new(bar_index, shortEntryPrice, bar_index + cancelAfter, close, border_color=color.green, bgcolor=color.new(color.green, zoneTransparency), border_width=1)
        slBox := box.new(bar_index, shortStopLoss, bar_index + cancelAfter, shortEntryPrice, border_color=color.red, bgcolor=color.new(color.red, zoneTransparency), border_width=1)
    
    strategy.entry("Short", strategy.short, limit=shortEntryPrice, qty=contracts)

// ==================== POSITION MANAGEMENT ====================
if strategy.position_size > 0 and not inLong
    inLong := true
    inShort := false
    longPending := false
    activeEntry := strategy.position_avg_price
    
    // Use pre-calculated SL or recalculate based on method
    if slMethod == "ATR"
        activeSL := activeEntry - (signalAtr * atrMultiplier)
    else
        activeSL := longStopLoss  // Use structure-based SL
    
    slDist = activeEntry - activeSL
    activeTP := activeEntry + (slDist * tpMultiplier)
    strategy.exit("Long Exit", "Long", stop=activeSL, limit=activeTP)
    
    if showHistoricalTrades
        line.new(bar_index, activeEntry, bar_index + 50, activeEntry, color=color.blue, width=1, style=line.style_solid)
        line.new(bar_index, activeSL, bar_index + 50, activeSL, color=color.red, width=1, style=line.style_dotted)
        line.new(bar_index, activeTP, bar_index + 50, activeTP, color=color.green, width=1, style=line.style_dotted)
    
    if not na(entryBox)
        box.delete(entryBox)
        entryBox := na
    if not na(slBox)
        box.delete(slBox)
        slBox := na

if strategy.position_size < 0 and not inShort
    inShort := true
    inLong := false
    shortPending := false
    activeEntry := strategy.position_avg_price
    
    // Use pre-calculated SL or recalculate based on method
    if slMethod == "ATR"
        activeSL := activeEntry + (signalAtr * atrMultiplier)
    else
        activeSL := shortStopLoss  // Use structure-based SL
    
    slDist = activeSL - activeEntry
    activeTP := activeEntry - (slDist * tpMultiplier)
    strategy.exit("Short Exit", "Short", stop=activeSL, limit=activeTP)
    
    if showHistoricalTrades
        line.new(bar_index, activeEntry, bar_index + 50, activeEntry, color=color.blue, width=1, style=line.style_solid)
        line.new(bar_index, activeSL, bar_index + 50, activeSL, color=color.red, width=1, style=line.style_dotted)
        line.new(bar_index, activeTP, bar_index + 50, activeTP, color=color.green, width=1, style=line.style_dotted)
    
    if not na(entryBox)
        box.delete(entryBox)
        entryBox := na
    if not na(slBox)
        box.delete(slBox)
        slBox := na

if strategy.position_size == 0 and (inLong or inShort)
    activeSL := na
    activeTP := na
    activeEntry := na
    inLong := false
    inShort := false
    longEntryPrice := na
    shortEntryPrice := na

// ==================== ORDER MANAGEMENT ====================
if longPending and strategy.position_size == 0
    longOrderBars += 1
    if longOrderBars >= cancelAfter
        strategy.cancel("Long")
        longPending := false
        longEntryPrice := na
        longOrderBars := 0
        if not na(entryBox)
            box.delete(entryBox)
            entryBox := na
        if not na(slBox)
            box.delete(slBox)
            slBox := na

if shortPending and strategy.position_size == 0
    shortOrderBars += 1
    if shortOrderBars >= cancelAfter
        strategy.cancel("Short")
        shortPending := false
        shortEntryPrice := na
        shortOrderBars := 0
        if not na(entryBox)
            box.delete(entryBox)
            entryBox := na
        if not na(slBox)
            box.delete(slBox)
            slBox := na

// ==================== VISUALIZATION ====================
bgColor = marketStructure == 1 ? color.new(color.green, 95) : marketStructure == -1 ? color.new(color.red, 95) : na
bgcolor(bgColor)
bgcolor(useSession and isInSession ? color.new(color.blue, 95) : na, title="Session")

plot(trendMethod == "EMA" ? ema : na, "EMA", color=color.orange, linewidth=2)

plot(inLong or inShort ? activeSL : na, "Current SL", color=color.red, style=plot.style_linebr, linewidth=2)
plot(inLong or inShort ? activeTP : na, "Current TP", color=color.green, style=plot.style_linebr, linewidth=2)
plot(inLong or inShort ? activeEntry : na, "Current Entry", color=color.blue, style=plot.style_linebr, linewidth=1)

// No-Wick Signals
plotshape(bullishNoBottomWick, "Bullish No Wick", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(bearishNoTopWick, "Bearish No Wick", shape.triangledown, location.abovebar, color.red, size=size.small)

// HTF Start Markers
plotshape(bullishNoWick30m and show_htf_marker, "Bullish 30m", shape.diamond, location.belowbar, color_30m, size=size.tiny)
plotshape(bearishNoWick30m and show_htf_marker, "Bearish 30m", shape.diamond, location.abovebar, color_30m, size=size.tiny)
plotshape(bullishNoWick1h and show_htf_marker, "Bullish 1h", shape.diamond, location.belowbar, color_1h, size=size.tiny)
plotshape(bearishNoWick1h and show_htf_marker, "Bearish 1h", shape.diamond, location.abovebar, color_1h, size=size.tiny)
plotshape(bullishNoWick4h and show_htf_marker, "Bullish 4h", shape.xcross, location.belowbar, color_4h, size=size.small)
plotshape(bearishNoWick4h and show_htf_marker, "Bearish 4h", shape.xcross, location.abovebar, color_4h, size=size.small)

// Valid signals
plotshape(isBullishNoWick and canGoLong, "Valid Long", shape.circle, location.belowbar, color.lime, size=size.tiny)
plotshape(isBearishNoWick and canGoShort, "Valid Short", shape.circle, location.abovebar, color.fuchsia, size=size.tiny)

// ==================== INFO TABLE ====================
var table infoTable = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 80))
if barstate.islast and showInfoTable
    htfText = is4hStart ? "4H ✖" : is1hStart ? "1H ◆" : is30mStart ? "30M ◆" : "-"
    htfColor = is4hStart ? color_4h : is1hStart ? color_1h : is30mStart ? color_30m : color.gray
    
    table.cell(infoTable, 0, 0, "Structure", text_color=color.white)
    table.cell(infoTable, 1, 0, marketStructure == 1 ? "BULLISH ↑" : marketStructure == -1 ? "BEARISH ↓" : "NEUTRAL", text_color=marketStructure == 1 ? color.green : marketStructure == -1 ? color.red : color.gray)
    table.cell(infoTable, 0, 1, "Trade", text_color=color.white)
    table.cell(infoTable, 1, 1, marketStructure == 1 ? "LONG ONLY" : marketStructure == -1 ? "SHORT ONLY" : "NONE", text_color=marketStructure == 1 ? color.green : marketStructure == -1 ? color.red : color.gray)
    table.cell(infoTable, 0, 2, "SL Method", text_color=color.white)
    table.cell(infoTable, 1, 2, slMethod, text_color=color.orange)
    table.cell(infoTable, 0, 3, "HTF Start", text_color=color.white)
    table.cell(infoTable, 1, 3, htfText, text_color=htfColor)
    table.cell(infoTable, 0, 4, "Last High", text_color=color.white)
    table.cell(infoTable, 1, 4, (isHigherHigh ? "HH " : "LH ") + str.tostring(h0, "#.##"), text_color=isHigherHigh ? color.green : color.red)
    table.cell(infoTable, 0, 5, "Last Low", text_color=color.white)
    table.cell(infoTable, 1, 5, (isHigherLow ? "HL " : "LL ") + str.tostring(l0, "#.##"), text_color=isHigherLow ? color.green : color.red)
    table.cell(infoTable, 0, 6, "Position", text_color=color.white)
    table.cell(infoTable, 1, 6, inLong ? "LONG" : inShort ? "SHORT" : "FLAT", text_color=inLong ? color.green : inShort ? color.red : color.gray)
    table.cell(infoTable, 0, 7, "Pending", text_color=color.white)
    table.cell(infoTable, 1, 7, longPending ? "LONG" : shortPending ? "SHORT" : "-", text_color=longPending ? color.green : shortPending ? color.red : color.gray)
    table.cell(infoTable, 0, 8, "SL", text_color=color.white)
    table.cell(infoTable, 1, 8, not na(activeSL) ? str.tostring(activeSL, "#.##") : "-", text_color=color.red)
    table.cell(infoTable, 0, 9, "TP", text_color=color.white)
    table.cell(infoTable, 1, 9, not na(activeTP) ? str.tostring(activeTP, "#.##") : "-", text_color=color.green)

// ==================== STATISTICS DASHBOARD ====================
// Create tables for each position (only one will be populated)
var table statsTableTL = table.new(position.top_left, 5, 6, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)
var table statsTableTR = table.new(position.top_right, 5, 6, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)
var table statsTableBL = table.new(position.bottom_left, 5, 6, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)
var table statsTableBR = table.new(position.bottom_right, 5, 6, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)

// Select table based on position
table statsTable = switch statsDashboardPos
    "Top Left" => statsTableTL
    "Top Right" => statsTableTR
    "Bottom Left" => statsTableBL
    => statsTableBR

if showStatsDashboard
    // Header row
    table.cell(statsTable, 0, 0, "TF", bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=size.small)
    table.cell(statsTable, 1, 0, "Bull %", bgcolor=color.new(color.green, 70), text_color=color.white, text_size=size.small)
    table.cell(statsTable, 2, 0, "Bear %", bgcolor=color.new(color.red, 70), text_color=color.white, text_size=size.small)
    table.cell(statsTable, 3, 0, "Total %", bgcolor=color.new(color.blue, 70), text_color=color.white, text_size=size.small)
    table.cell(statsTable, 4, 0, "Count", bgcolor=color.new(color.gray, 60), text_color=color.white, text_size=size.small)
    
    // Current TF row
    table.cell(statsTable, 0, 1, timeframe.period, text_color=color.yellow, text_size=size.small)
    table.cell(statsTable, 1, 1, str.tostring(nz(pctBullCurrent, 0), "#.#") + "%", text_color=color.green, text_size=size.small)
    table.cell(statsTable, 2, 1, str.tostring(nz(pctBearCurrent, 0), "#.#") + "%", text_color=color.red, text_size=size.small)
    table.cell(statsTable, 3, 1, str.tostring(nz(pctCurrent, 0), "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(statsTable, 4, 1, str.tostring(math.round(nz(countTotalCurrent, 0))), text_color=color.white, text_size=size.small)
    
    // M15 row
    table.cell(statsTable, 0, 2, "M15", text_color=color.white, text_size=size.small)
    table.cell(statsTable, 1, 2, str.tostring(nz(pctBull15, 0), "#.#") + "%", text_color=color.green, text_size=size.small)
    table.cell(statsTable, 2, 2, str.tostring(nz(pctBear15, 0), "#.#") + "%", text_color=color.red, text_size=size.small)
    table.cell(statsTable, 3, 2, str.tostring(nz(pct15, 0), "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(statsTable, 4, 2, str.tostring(math.round(nz(countBull15 + countBear15, 0))), text_color=color.white, text_size=size.small)
    
    // M30 row
    table.cell(statsTable, 0, 3, "M30", text_color=color.white, text_size=size.small)
    table.cell(statsTable, 1, 3, str.tostring(nz(pctBull30, 0), "#.#") + "%", text_color=color.green, text_size=size.small)
    table.cell(statsTable, 2, 3, str.tostring(nz(pctBear30, 0), "#.#") + "%", text_color=color.red, text_size=size.small)
    table.cell(statsTable, 3, 3, str.tostring(nz(pct30, 0), "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(statsTable, 4, 3, str.tostring(math.round(nz(countBull30 + countBear30, 0))), text_color=color.white, text_size=size.small)
    
    // H1 row
    table.cell(statsTable, 0, 4, "H1", text_color=color.white, text_size=size.small)
    table.cell(statsTable, 1, 4, str.tostring(nz(pctBull60, 0), "#.#") + "%", text_color=color.green, text_size=size.small)
    table.cell(statsTable, 2, 4, str.tostring(nz(pctBear60, 0), "#.#") + "%", text_color=color.red, text_size=size.small)
    table.cell(statsTable, 3, 4, str.tostring(nz(pct60, 0), "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(statsTable, 4, 4, str.tostring(math.round(nz(countBull60 + countBear60, 0))), text_color=color.white, text_size=size.small)
    
    // H4 row
    table.cell(statsTable, 0, 5, "H4", text_color=color.white, text_size=size.small)
    table.cell(statsTable, 1, 5, str.tostring(nz(pctBull240, 0), "#.#") + "%", text_color=color.green, text_size=size.small)
    table.cell(statsTable, 2, 5, str.tostring(nz(pctBear240, 0), "#.#") + "%", text_color=color.red, text_size=size.small)
    table.cell(statsTable, 3, 5, str.tostring(nz(pct240, 0), "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(statsTable, 4, 5, str.tostring(math.round(nz(countBull240 + countBear240, 0))), text_color=color.white, text_size=size.small)

// ==================== ALERTS ====================
alertcondition(chochBullish, "Bullish ChoCH", "ChoCH Bullish - LONG ONLY!")
alertcondition(chochBearish, "Bearish ChoCH", "ChoCH Bearish - SHORT ONLY!")
alertcondition(bosBullish, "Bullish BOS", "BOS Bullish!")
alertcondition(bosBearish, "Bearish BOS", "BOS Bearish!")
alertcondition(bullishNoWick4h or bearishNoWick4h, "No-Wick 4H Start", "No-Wick at 4H candle start!")
alertcondition(bullishNoWick1h or bearishNoWick1h, "No-Wick 1H Start", "No-Wick at 1H candle start!")
alertcondition(bullishNoWick30m or bearishNoWick30m, "No-Wick 30M Start", "No-Wick at 30M candle start!")
