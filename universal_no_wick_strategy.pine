//@version=5
strategy("Universal No Wick Market Structure Strategy", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, max_lines_count=500, max_boxes_count=500)

// ==================== MARKET STRUCTURE INPUTS ====================
msSettings = "Market Structure Settings"
zigzag_len = input.int(9, "ZigZag Length", group=msSettings, minval=3)
show_zigzag = input.bool(true, "Show ZigZag", group=msSettings)
show_hh_ll = input.bool(true, "Show HH/HL/LH/LL Labels", group=msSettings)

// ==================== NO WICK INPUTS ====================
nwSettings = "No Wick Candle Settings"
wickThreshold = input.float(10, "Max Wick Size (% of candle)", minval=0, maxval=50, step=1, group=nwSettings) / 100
minBodyAtr = input.float(0.3, "Min Body Size (x ATR)", minval=0.1, step=0.1, group=nwSettings)
maxBodyAtr = input.float(3.0, "Max Body Size (x ATR)", minval=0.5, step=0.1, group=nwSettings)

// ==================== TRADE INPUTS ====================
tradeSettings = "Trade Settings"
contracts = input.int(1, "Number of Contracts", minval=1, group=tradeSettings)
cancelAfter = input.int(10, "Cancel Order After X Candles", minval=1, group=tradeSettings)
slAtrBuffer = input.float(0.5, "SL ATR Buffer (below/above structure)", minval=0, step=0.1, group=tradeSettings, tooltip="ATR multiplier added below last Low (Long) or above last High (Short)")
tpRiskReward = input.float(2.0, "TP Risk:Reward Ratio", minval=0.5, step=0.1, group=tradeSettings, tooltip="Take Profit = Entry + (SL Distance x this value)")

// ==================== SESSION INPUTS ====================
sessionSettings = "Session Settings"
useSession = input.bool(false, "Use Session Filter", group=sessionSettings)
tradingSession = input.session("0200-1600", "Trading Session (NY Time)", group=sessionSettings)

// ==================== VISUAL INPUTS ====================
visualSettings = "Visual Settings"
showZones = input.bool(true, "Show Entry/SL Zones", group=visualSettings)
zoneTransparency = input.int(80, "Zone Transparency", minval=0, maxval=100, group=visualSettings)

// ==================== MARKET STRUCTURE CALCULATION ====================
var float[] high_points_arr = array.new_float(5)
var int[] high_index_arr = array.new_int(5)
var float[] low_points_arr = array.new_float(5)
var int[] low_index_arr = array.new_int(5)

to_up = high >= ta.highest(zigzag_len)
to_down = low <= ta.lowest(zigzag_len)

var int trend = 1
trend := trend == 1 and to_down ? -1 : trend == -1 and to_up ? 1 : trend

last_trend_up_since = ta.barssince(to_up[1])
low_val = ta.lowest(nz(last_trend_up_since > 0 ? last_trend_up_since : 1, 1))
low_index = bar_index - ta.barssince(low_val == low)

last_trend_down_since = ta.barssince(to_down[1])
high_val = ta.highest(nz(last_trend_down_since > 0 ? last_trend_down_since : 1, 1))
high_index = bar_index - ta.barssince(high_val == high)

if ta.change(trend) != 0
    if trend == 1
        array.push(low_points_arr, low_val)
        array.push(low_index_arr, low_index)
    if trend == -1
        array.push(high_points_arr, high_val)
        array.push(high_index_arr, high_index)

f_get_high(ind) =>
    [array.get(high_points_arr, math.max(0, array.size(high_points_arr) - 1 - ind)), array.get(high_index_arr, math.max(0, array.size(high_index_arr) - 1 - ind))]

f_get_low(ind) =>
    [array.get(low_points_arr, math.max(0, array.size(low_points_arr) - 1 - ind)), array.get(low_index_arr, math.max(0, array.size(low_index_arr) - 1 - ind))]

[h0, h0i] = f_get_high(0)
[h1, h1i] = f_get_high(1)
[l0, l0i] = f_get_low(0)
[l1, l1i] = f_get_low(1)

if ta.change(trend) != 0 and show_zigzag
    if trend == 1
        line.new(h0i, h0, l0i, l0, color=color.gray, width=1)
    if trend == -1
        line.new(l0i, l0, h0i, h0, color=color.gray, width=1)

// ==================== MARKET STRUCTURE TREND ====================
isHigherHigh = h0 > h1
isHigherLow = l0 > l1
isLowerHigh = h0 < h1
isLowerLow = l0 < l1

var int marketStructure = 0
if isHigherHigh and isHigherLow
    marketStructure := 1
else if isLowerHigh and isLowerLow
    marketStructure := -1

isBullishStructure = marketStructure == 1
isBearishStructure = marketStructure == -1

// ==================== HH/HL/LH/LL LABELS ====================
var label lastHighLabel = na
var label lastLowLabel = na

if ta.change(trend) != 0 and show_hh_ll
    if trend == -1
        if not na(lastHighLabel)
            label.delete(lastHighLabel)
        labelText = isHigherHigh ? "HH" : "LH"
        labelColor = isHigherHigh ? color.green : color.red
        lastHighLabel := label.new(h0i, h0, labelText, color=color.new(color.black, 100), style=label.style_label_down, textcolor=labelColor, size=size.small)
    
    if trend == 1
        if not na(lastLowLabel)
            label.delete(lastLowLabel)
        labelText = isHigherLow ? "HL" : "LL"
        labelColor = isHigherLow ? color.green : color.red
        lastLowLabel := label.new(l0i, l0, labelText, color=color.new(color.black, 100), style=label.style_label_up, textcolor=labelColor, size=size.small)

// ==================== ATR & NO WICK DETECTION ====================
atr = ta.atr(14)

bodySize = math.abs(close - open)
totalSize = high - low
safeTotal = totalSize > 0 ? totalSize : 1

upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

upperWickPercent = upperWick / safeTotal
lowerWickPercent = lowerWick / safeTotal
bodyAtrRatio = bodySize / atr

isBullishCandle = close > open
hasSmallLowerWick = lowerWickPercent <= wickThreshold
validBullishBody = bodyAtrRatio >= minBodyAtr and bodyAtrRatio <= maxBodyAtr
isBullishNoWick = isBullishCandle and hasSmallLowerWick and validBullishBody and isBullishStructure

isBearishCandle = close < open
hasSmallUpperWick = upperWickPercent <= wickThreshold
validBearishBody = bodyAtrRatio >= minBodyAtr and bodyAtrRatio <= maxBodyAtr
isBearishNoWick = isBearishCandle and hasSmallUpperWick and validBearishBody and isBearishStructure

isInSession = useSession ? not na(time(timeframe.period, tradingSession)) : true

// ==================== STRATEGY VARIABLES ====================
var float longEntryPrice = na
var float longStopLoss = na
var float longTakeProfit = na
var int longOrderBars = 0
var bool longPending = false

var float shortEntryPrice = na
var float shortStopLoss = na
var float shortTakeProfit = na
var int shortOrderBars = 0
var bool shortPending = false

var float signalAtr = na
var float structureSL = na
var box entryBox = na
var box slBox = na

var float activeSL = na
var float activeTP = na
var bool inLong = false
var bool inShort = false

// ==================== LONG SETUP ====================
// SL = Last Low - ATR Buffer
// TP = Entry + (Entry - SL) * RR Ratio
if isBullishNoWick and isInSession and strategy.position_size == 0 and not longPending and not shortPending
    if not na(entryBox)
        box.delete(entryBox)
    if not na(slBox)
        box.delete(slBox)
    
    longEntryPrice := open
    signalAtr := atr
    structureSL := l0  // Last Low of structure
    longStopLoss := structureSL - (signalAtr * slAtrBuffer)  // SL below last Low + ATR buffer
    slDistance = longEntryPrice - longStopLoss
    longTakeProfit := longEntryPrice + (slDistance * tpRiskReward)  // TP based on Risk:Reward
    longOrderBars := 0
    longPending := true
    
    if showZones
        entryBox := box.new(bar_index, close, bar_index + cancelAfter, longEntryPrice, border_color=color.green, bgcolor=color.new(color.green, zoneTransparency), border_width=1)
        slBox := box.new(bar_index, longEntryPrice, bar_index + cancelAfter, longStopLoss, border_color=color.red, bgcolor=color.new(color.red, zoneTransparency), border_width=1)
    
    strategy.entry("Long", strategy.long, limit=longEntryPrice, qty=contracts)

// ==================== SHORT SETUP ====================
// SL = Last High + ATR Buffer
// TP = Entry - (SL - Entry) * RR Ratio
if isBearishNoWick and isInSession and strategy.position_size == 0 and not shortPending and not longPending
    if not na(entryBox)
        box.delete(entryBox)
    if not na(slBox)
        box.delete(slBox)
    
    shortEntryPrice := open
    signalAtr := atr
    structureSL := h0  // Last High of structure
    shortStopLoss := structureSL + (signalAtr * slAtrBuffer)  // SL above last High + ATR buffer
    slDistance = shortStopLoss - shortEntryPrice
    shortTakeProfit := shortEntryPrice - (slDistance * tpRiskReward)  // TP based on Risk:Reward
    shortOrderBars := 0
    shortPending := true
    
    if showZones
        entryBox := box.new(bar_index, shortEntryPrice, bar_index + cancelAfter, close, border_color=color.green, bgcolor=color.new(color.green, zoneTransparency), border_width=1)
        slBox := box.new(bar_index, shortStopLoss, bar_index + cancelAfter, shortEntryPrice, border_color=color.red, bgcolor=color.new(color.red, zoneTransparency), border_width=1)
    
    strategy.entry("Short", strategy.short, limit=shortEntryPrice, qty=contracts)

// ==================== POSITION MANAGEMENT ====================
if strategy.position_size > 0 and not inLong
    inLong := true
    inShort := false
    longPending := false
    // Recalculate SL/TP based on actual entry price
    activeSL := structureSL - (signalAtr * slAtrBuffer)
    slDist = strategy.position_avg_price - activeSL
    activeTP := strategy.position_avg_price + (slDist * tpRiskReward)
    strategy.exit("Long Exit", "Long", stop=activeSL, limit=activeTP)
    if not na(entryBox)
        box.delete(entryBox)
        entryBox := na
    if not na(slBox)
        box.delete(slBox)
        slBox := na

if strategy.position_size < 0 and not inShort
    inShort := true
    inLong := false
    shortPending := false
    // Recalculate SL/TP based on actual entry price
    activeSL := structureSL + (signalAtr * slAtrBuffer)
    slDist = activeSL - strategy.position_avg_price
    activeTP := strategy.position_avg_price - (slDist * tpRiskReward)
    strategy.exit("Short Exit", "Short", stop=activeSL, limit=activeTP)
    if not na(entryBox)
        box.delete(entryBox)
        entryBox := na
    if not na(slBox)
        box.delete(slBox)
        slBox := na

if strategy.position_size == 0
    if inLong or inShort
        activeSL := na
        activeTP := na
        inLong := false
        inShort := false
        longEntryPrice := na
        shortEntryPrice := na
        structureSL := na

// ==================== ORDER MANAGEMENT ====================
if longPending and strategy.position_size == 0
    longOrderBars := longOrderBars + 1
    if longOrderBars >= cancelAfter
        strategy.cancel("Long")
        longEntryPrice := na
        longStopLoss := na
        longTakeProfit := na
        longOrderBars := 0
        longPending := false
        if not na(entryBox)
            box.delete(entryBox)
            entryBox := na
        if not na(slBox)
            box.delete(slBox)
            slBox := na

if shortPending and strategy.position_size == 0
    shortOrderBars := shortOrderBars + 1
    if shortOrderBars >= cancelAfter
        strategy.cancel("Short")
        shortEntryPrice := na
        shortStopLoss := na
        shortTakeProfit := na
        shortOrderBars := 0
        shortPending := false
        if not na(entryBox)
            box.delete(entryBox)
            entryBox := na
        if not na(slBox)
            box.delete(slBox)
            slBox := na

// ==================== VISUALIZATION ====================
bgcolor(isBullishStructure ? color.new(color.green, 95) : isBearishStructure ? color.new(color.red, 95) : na)

// Plot structure level used for SL
plot(longPending ? structureSL : shortPending ? structureSL : na, "Structure Level", color=color.orange, style=plot.style_linebr, linewidth=1)

// Plot active SL/TP lines
plot(inLong or inShort ? activeSL : na, "Stop Loss", color=color.red, style=plot.style_linebr, linewidth=2)
plot(inLong or inShort ? activeTP : na, "Take Profit", color=color.green, style=plot.style_linebr, linewidth=2)
plot(inLong or inShort ? strategy.position_avg_price : na, "Entry", color=color.blue, style=plot.style_linebr, linewidth=1)

// Plot signals
plotshape(isBullishNoWick and isInSession and strategy.position_size == 0 and not longPending and not shortPending, "Bullish No Wick", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(isBearishNoWick and isInSession and strategy.position_size == 0 and not longPending and not shortPending, "Bearish No Wick", shape.triangledown, location.abovebar, color.red, size=size.small)

// ==================== INFO TABLE ====================
var table infoTable = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 80))
if barstate.islast
    table.cell(infoTable, 0, 0, "Structure", text_color=color.white)
    table.cell(infoTable, 1, 0, isBullishStructure ? "BULLISH (HH+HL)" : isBearishStructure ? "BEARISH (LH+LL)" : "NEUTRAL", text_color=isBullishStructure ? color.green : isBearishStructure ? color.red : color.gray)
    table.cell(infoTable, 0, 1, "Last High", text_color=color.white)
    table.cell(infoTable, 1, 1, (isHigherHigh ? "HH " : "LH ") + str.tostring(h0, "#.##"), text_color=isHigherHigh ? color.green : color.red)
    table.cell(infoTable, 0, 2, "Last Low", text_color=color.white)
    table.cell(infoTable, 1, 2, (isHigherLow ? "HL " : "LL ") + str.tostring(l0, "#.##"), text_color=isHigherLow ? color.green : color.red)
    table.cell(infoTable, 0, 3, "Position", text_color=color.white)
    table.cell(infoTable, 1, 3, inLong ? "LONG" : inShort ? "SHORT" : "FLAT", text_color=inLong ? color.green : inShort ? color.red : color.gray)
    table.cell(infoTable, 0, 4, "Entry", text_color=color.white)
    table.cell(infoTable, 1, 4, strategy.position_size != 0 ? str.tostring(strategy.position_avg_price, "#.##") : "-", text_color=color.blue)
    table.cell(infoTable, 0, 5, "Stop Loss", text_color=color.white)
    table.cell(infoTable, 1, 5, not na(activeSL) ? str.tostring(activeSL, "#.##") : "-", text_color=color.red)
    table.cell(infoTable, 0, 6, "Take Profit", text_color=color.white)
    table.cell(infoTable, 1, 6, not na(activeTP) ? str.tostring(activeTP, "#.##") : "-", text_color=color.green)
