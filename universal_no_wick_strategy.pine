//@version=5
strategy("Universal No Wick Pullback Strategy", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// ==================== INPUTS ====================
emaLength = input.int(50, "EMA Length for Trend", minval=5)
useEmaFilter = input.bool(true, "Use EMA Trend Filter")

wickThreshold = input.float(10, "Max Wick Size (% of candle)", minval=0, maxval=50, step=1) / 100
minBodyAtr = input.float(0.3, "Min Body Size (x ATR)", minval=0.1, step=0.1)
maxBodyAtr = input.float(3.0, "Max Body Size (x ATR)", minval=0.5, step=0.1)

contracts = input.int(1, "Number of Contracts", minval=1)
cancelAfter = input.int(10, "Cancel Order After X Candles", minval=1)

atrMultiplier = input.float(1.5, "ATR Multiplier for SL", minval=0.1, step=0.1)
tpMultiplier = input.float(2.0, "TP (x SL)", minval=0.1, step=0.1)

useSession = input.bool(false, "Use Session Filter")
tradingSession = input.session("0200-1600", "Trading Session (NY Time)")

showZones = input.bool(true, "Show Entry/SL Zones")
zoneTransparency = input.int(80, "Zone Transparency", minval=0, maxval=100)

// ==================== CALCULATIONS ====================
atr = ta.atr(14)
ema = ta.ema(close, emaLength)

isUptrend = close > ema
isDowntrend = close < ema

bodySize = math.abs(close - open)
totalSize = high - low
safeTotal = totalSize > 0 ? totalSize : 1

upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

upperWickPercent = upperWick / safeTotal
lowerWickPercent = lowerWick / safeTotal
bodyAtrRatio = bodySize / atr

// ==================== NO WICK DETECTION ====================
isBullishCandle = close > open
hasSmallLowerWick = lowerWickPercent <= wickThreshold
validBullishBody = bodyAtrRatio >= minBodyAtr and bodyAtrRatio <= maxBodyAtr
trendOkBullish = useEmaFilter ? isUptrend : true
isBullishNoWick = isBullishCandle and hasSmallLowerWick and validBullishBody and trendOkBullish

isBearishCandle = close < open
hasSmallUpperWick = upperWickPercent <= wickThreshold
validBearishBody = bodyAtrRatio >= minBodyAtr and bodyAtrRatio <= maxBodyAtr
trendOkBearish = useEmaFilter ? isDowntrend : true
isBearishNoWick = isBearishCandle and hasSmallUpperWick and validBearishBody and trendOkBearish

isInSession = useSession ? not na(time(timeframe.period, tradingSession)) : true

// ==================== STRATEGY VARIABLES ====================
var float longEntryPrice = na
var float longStopLoss = na
var float longTakeProfit = na
var int longOrderBars = 0
var bool longPending = false

var float shortEntryPrice = na
var float shortStopLoss = na
var float shortTakeProfit = na
var int shortOrderBars = 0
var bool shortPending = false

var float signalAtr = na
var box entryBox = na
var box slBox = na

// Track actual position SL/TP
var float activeSL = na
var float activeTP = na
var bool inLong = false
var bool inShort = false

// ==================== LONG SETUP ====================
if isBullishNoWick and isInSession and strategy.position_size == 0 and not longPending and not shortPending
    if not na(entryBox)
        box.delete(entryBox)
    if not na(slBox)
        box.delete(slBox)
    
    longEntryPrice := open
    signalAtr := atr
    longStopLoss := longEntryPrice - (signalAtr * atrMultiplier)
    longTakeProfit := longEntryPrice + (signalAtr * atrMultiplier * tpMultiplier)
    longOrderBars := 0
    longPending := true
    
    if showZones
        entryBox := box.new(bar_index, close, bar_index + cancelAfter, longEntryPrice, border_color=color.green, bgcolor=color.new(color.green, zoneTransparency), border_width=1)
        slBox := box.new(bar_index, longEntryPrice, bar_index + cancelAfter, longStopLoss, border_color=color.red, bgcolor=color.new(color.red, zoneTransparency), border_width=1)
    
    strategy.entry("Long", strategy.long, limit=longEntryPrice, qty=contracts)

// ==================== SHORT SETUP ====================
if isBearishNoWick and isInSession and strategy.position_size == 0 and not shortPending and not longPending
    if not na(entryBox)
        box.delete(entryBox)
    if not na(slBox)
        box.delete(slBox)
    
    shortEntryPrice := open
    signalAtr := atr
    shortStopLoss := shortEntryPrice + (signalAtr * atrMultiplier)
    shortTakeProfit := shortEntryPrice - (signalAtr * atrMultiplier * tpMultiplier)
    shortOrderBars := 0
    shortPending := true
    
    if showZones
        entryBox := box.new(bar_index, shortEntryPrice, bar_index + cancelAfter, close, border_color=color.green, bgcolor=color.new(color.green, zoneTransparency), border_width=1)
        slBox := box.new(bar_index, shortStopLoss, bar_index + cancelAfter, shortEntryPrice, border_color=color.red, bgcolor=color.new(color.red, zoneTransparency), border_width=1)
    
    strategy.entry("Short", strategy.short, limit=shortEntryPrice, qty=contracts)

// ==================== POSITION MANAGEMENT ====================
// Detect when long position is opened
if strategy.position_size > 0 and not inLong
    inLong := true
    inShort := false
    longPending := false
    // Set SL/TP based on actual entry price
    activeSL := strategy.position_avg_price - (signalAtr * atrMultiplier)
    activeTP := strategy.position_avg_price + (signalAtr * atrMultiplier * tpMultiplier)
    strategy.exit("Long Exit", "Long", stop=activeSL, limit=activeTP)
    // Clean up boxes
    if not na(entryBox)
        box.delete(entryBox)
        entryBox := na
    if not na(slBox)
        box.delete(slBox)
        slBox := na

// Detect when short position is opened
if strategy.position_size < 0 and not inShort
    inShort := true
    inLong := false
    shortPending := false
    // Set SL/TP based on actual entry price
    activeSL := strategy.position_avg_price + (signalAtr * atrMultiplier)
    activeTP := strategy.position_avg_price - (signalAtr * atrMultiplier * tpMultiplier)
    strategy.exit("Short Exit", "Short", stop=activeSL, limit=activeTP)
    // Clean up boxes
    if not na(entryBox)
        box.delete(entryBox)
        entryBox := na
    if not na(slBox)
        box.delete(slBox)
        slBox := na

// Reset when position is closed
if strategy.position_size == 0
    if inLong or inShort
        activeSL := na
        activeTP := na
        inLong := false
        inShort := false
        longEntryPrice := na
        shortEntryPrice := na

// ==================== ORDER MANAGEMENT ====================
if longPending and strategy.position_size == 0
    longOrderBars := longOrderBars + 1
    if longOrderBars >= cancelAfter
        strategy.cancel("Long")
        longEntryPrice := na
        longStopLoss := na
        longTakeProfit := na
        longOrderBars := 0
        longPending := false
        if not na(entryBox)
            box.delete(entryBox)
            entryBox := na
        if not na(slBox)
            box.delete(slBox)
            slBox := na

if shortPending and strategy.position_size == 0
    shortOrderBars := shortOrderBars + 1
    if shortOrderBars >= cancelAfter
        strategy.cancel("Short")
        shortEntryPrice := na
        shortStopLoss := na
        shortTakeProfit := na
        shortOrderBars := 0
        shortPending := false
        if not na(entryBox)
            box.delete(entryBox)
            entryBox := na
        if not na(slBox)
            box.delete(slBox)
            slBox := na

// ==================== VISUALIZATION ====================
plot(ema, "EMA", color=color.orange, linewidth=2)

// Plot active SL/TP lines when in position
plot(inLong or inShort ? activeSL : na, "Stop Loss", color=color.red, style=plot.style_linebr, linewidth=2)
plot(inLong or inShort ? activeTP : na, "Take Profit", color=color.green, style=plot.style_linebr, linewidth=2)
plot(inLong or inShort ? strategy.position_avg_price : na, "Entry", color=color.blue, style=plot.style_linebr, linewidth=1)

// Plot signals
plotshape(isBullishNoWick and isInSession and strategy.position_size == 0 and not longPending and not shortPending, "Bullish No Wick", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(isBearishNoWick and isInSession and strategy.position_size == 0 and not longPending and not shortPending, "Bearish No Wick", shape.triangledown, location.abovebar, color.red, size=size.small)

// ==================== INFO TABLE ====================
var table infoTable = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 80))
if barstate.islast
    table.cell(infoTable, 0, 0, "Position", text_color=color.white)
    table.cell(infoTable, 1, 0, inLong ? "LONG" : inShort ? "SHORT" : "FLAT", text_color=inLong ? color.green : inShort ? color.red : color.gray)
    table.cell(infoTable, 0, 1, "Entry", text_color=color.white)
    table.cell(infoTable, 1, 1, strategy.position_size != 0 ? str.tostring(strategy.position_avg_price, "#.##") : "-", text_color=color.blue)
    table.cell(infoTable, 0, 2, "Stop Loss", text_color=color.white)
    table.cell(infoTable, 1, 2, not na(activeSL) ? str.tostring(activeSL, "#.##") : "-", text_color=color.red)
    table.cell(infoTable, 0, 3, "Take Profit", text_color=color.white)
    table.cell(infoTable, 1, 3, not na(activeTP) ? str.tostring(activeTP, "#.##") : "-", text_color=color.green)
