//@version=5
strategy("Universal No Wick Market Structure Strategy", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// ==================== TREND FILTER METHOD ====================
filterSettings = "Trend Filter Settings"
trendMethod = input.string("Market Structure", "Trend Filter Method", options=["Market Structure", "EMA"], group=filterSettings)
emaLength = input.int(50, "EMA Length", group=filterSettings, minval=5, tooltip="Only used when EMA method is selected")

// ==================== MARKET STRUCTURE INPUTS ====================
msSettings = "Market Structure Settings"
zigzag_len = input.int(9, "ZigZag Length", group=msSettings, minval=3)
show_zigzag = input.bool(true, "Show ZigZag", group=msSettings)
show_hh_ll = input.bool(true, "Show HH/HL/LH/LL Labels", group=msSettings)
show_choch = input.bool(true, "Show Change of Character (ChoCH)", group=msSettings)
show_bos = input.bool(true, "Show Break of Structure (BOS)", group=msSettings)

// ==================== NO WICK INPUTS ====================
nwSettings = "No Wick Candle Settings"
show_compensation = input.bool(true, "Show Compensation Lines", group=nwSettings)
show_compensation_label = input.bool(true, "Show Compensation Label", group=nwSettings)
compensationBars = input.int(20, "Compensation Line Length (bars)", group=nwSettings, minval=1)

// ==================== TRADE INPUTS ====================
tradeSettings = "Trade Settings"
contracts = input.int(1, "Number of Contracts", minval=1, group=tradeSettings)
cancelAfter = input.int(10, "Cancel Order After X Candles", minval=1, group=tradeSettings)
atrMultiplier = input.float(1.5, "ATR Multiplier for SL", minval=0.1, step=0.1, group=tradeSettings)
tpMultiplier = input.float(2.0, "TP (x SL)", minval=0.1, step=0.1, group=tradeSettings)

// ==================== SESSION INPUTS ====================
sessionSettings = "Session Settings"
useSession = input.bool(false, "Use Session Filter", group=sessionSettings)
tradingSession = input.session("0200-1600", "Trading Session", group=sessionSettings)
sessionTimezone = input.string("America/New_York", "Session Timezone", options=["America/New_York", "America/Chicago", "America/Los_Angeles", "America/Toronto", "Europe/London", "Europe/Berlin", "Europe/Paris", "Europe/Zurich", "Europe/Moscow", "Asia/Tokyo", "Asia/Hong_Kong", "Asia/Shanghai", "Asia/Singapore", "Asia/Dubai", "Asia/Kolkata", "Australia/Sydney", "Pacific/Auckland", "UTC"], group=sessionSettings)

// ==================== VISUAL INPUTS ====================
visualSettings = "Visual Settings"
showZones = input.bool(true, "Show Entry/SL Zones", group=visualSettings)
zoneTransparency = input.int(80, "Zone Transparency", minval=0, maxval=100, group=visualSettings)

// ==================== EMA CALCULATION ====================
ema = ta.ema(close, emaLength)
isEmaUptrend = close > ema
isEmaDowntrend = close < ema

// ==================== MARKET STRUCTURE CALCULATION ====================
var float[] high_points_arr = array.new_float(5)
var int[] high_index_arr = array.new_int(5)
var float[] low_points_arr = array.new_float(5)
var int[] low_index_arr = array.new_int(5)

to_up = high >= ta.highest(zigzag_len)
to_down = low <= ta.lowest(zigzag_len)

var int zigzagTrend = 1
zigzagTrend := zigzagTrend == 1 and to_down ? -1 : zigzagTrend == -1 and to_up ? 1 : zigzagTrend

last_trend_up_since = ta.barssince(to_up[1])
low_val = ta.lowest(nz(last_trend_up_since > 0 ? last_trend_up_since : 1, 1))
low_index = bar_index - ta.barssince(low_val == low)

last_trend_down_since = ta.barssince(to_down[1])
high_val = ta.highest(nz(last_trend_down_since > 0 ? last_trend_down_since : 1, 1))
high_index = bar_index - ta.barssince(high_val == high)

if ta.change(zigzagTrend) != 0
    if zigzagTrend == 1
        array.push(low_points_arr, low_val)
        array.push(low_index_arr, low_index)
    if zigzagTrend == -1
        array.push(high_points_arr, high_val)
        array.push(high_index_arr, high_index)

f_get_high(ind) =>
    [array.get(high_points_arr, math.max(0, array.size(high_points_arr) - 1 - ind)), array.get(high_index_arr, math.max(0, array.size(high_index_arr) - 1 - ind))]

f_get_low(ind) =>
    [array.get(low_points_arr, math.max(0, array.size(low_points_arr) - 1 - ind)), array.get(low_index_arr, math.max(0, array.size(low_index_arr) - 1 - ind))]

[h0, h0i] = f_get_high(0)
[h1, h1i] = f_get_high(1)
[l0, l0i] = f_get_low(0)
[l1, l1i] = f_get_low(1)

// Draw ZigZag
if ta.change(zigzagTrend) != 0 and show_zigzag and trendMethod == "Market Structure"
    if zigzagTrend == 1
        line.new(h0i, h0, l0i, l0, color=color.gray, width=1)
    if zigzagTrend == -1
        line.new(l0i, l0, h0i, h0, color=color.gray, width=1)

// ==================== SWING POINT CLASSIFICATION ====================
isHigherHigh = h0 > h1
isHigherLow = l0 > l1
isLowerHigh = h0 < h1
isLowerLow = l0 < l1

// ==================== MARKET STRUCTURE STATE (PERSISTENT) ====================
var int marketStructure = 0  // -1 = Bearish, 0 = Neutral, 1 = Bullish

// ==================== ChoCH & BOS DETECTION ====================
var bool chochBullishTriggered = false
var bool chochBearishTriggered = false
var bool bosBullishTriggered = false
var bool bosBearishTriggered = false

chochBullish = false
chochBearish = false
bosBullish = false
bosBearish = false

var float eventLevel = na
var int eventBar = na

// STEP 1: Check for ChoCH (Structure Change)
// Bullish ChoCH: Close above LH when structure is NOT bullish
if close > h0 and isLowerHigh and marketStructure != 1 and not chochBullishTriggered
    chochBullish := true
    chochBullishTriggered := true
    chochBearishTriggered := false
    bosBullishTriggered := false
    bosBearishTriggered := false
    eventLevel := h0
    eventBar := h0i
    marketStructure := 1  // IMMEDIATELY set to Bullish

// Bearish ChoCH: Close below HL when structure is NOT bearish
if close < l0 and isHigherLow and marketStructure != -1 and not chochBearishTriggered
    chochBearish := true
    chochBearishTriggered := true
    chochBullishTriggered := false
    bosBullishTriggered := false
    bosBearishTriggered := false
    eventLevel := l0
    eventBar := l0i
    marketStructure := -1  // IMMEDIATELY set to Bearish

// STEP 2: Check for BOS (Structure Continuation) - only if no ChoCH on this bar
if not chochBullish and not chochBearish
    // BOS Bullish: Already bullish, close above HH
    if close > h0 and isHigherHigh and marketStructure == 1 and not bosBullishTriggered
        bosBullish := true
        bosBullishTriggered := true
        eventLevel := h0
        eventBar := h0i
    
    // BOS Bearish: Already bearish, close below LL
    if close < l0 and isLowerLow and marketStructure == -1 and not bosBearishTriggered
        bosBearish := true
        bosBearishTriggered := true
        eventLevel := l0
        eventBar := l0i

// Reset triggers when new swing points form
if ta.change(zigzagTrend) != 0
    chochBullishTriggered := false
    chochBearishTriggered := false
    bosBullishTriggered := false
    bosBearishTriggered := false

// ==================== FINAL STRUCTURE STATUS ====================
isMSBullishStructure = marketStructure == 1
isMSBearishStructure = marketStructure == -1

// ==================== COMBINED TREND FILTER ====================
isBullishStructure = trendMethod == "Market Structure" ? isMSBullishStructure : isEmaUptrend
isBearishStructure = trendMethod == "Market Structure" ? isMSBearishStructure : isEmaDowntrend

// ==================== HH/HL/LH/LL LABELS ====================
var label lastHighLabel = na
var label lastLowLabel = na

if ta.change(zigzagTrend) != 0 and show_hh_ll and trendMethod == "Market Structure"
    if zigzagTrend == -1
        if not na(lastHighLabel)
            label.delete(lastHighLabel)
        labelText = isHigherHigh ? "HH" : "LH"
        labelColor = isHigherHigh ? color.green : color.red
        lastHighLabel := label.new(h0i, h0, labelText, color=color.new(color.black, 100), style=label.style_label_down, textcolor=labelColor, size=size.small)
    
    if zigzagTrend == 1
        if not na(lastLowLabel)
            label.delete(lastLowLabel)
        labelText = isHigherLow ? "HL" : "LL"
        labelColor = isHigherLow ? color.green : color.red
        lastLowLabel := label.new(l0i, l0, labelText, color=color.new(color.black, 100), style=label.style_label_up, textcolor=labelColor, size=size.small)

// ==================== ChoCH VISUALIZATION ====================
if chochBullish and show_choch and trendMethod == "Market Structure"
    line.new(eventBar, eventLevel, bar_index, eventLevel, color=color.green, width=2, style=line.style_solid)
    label.new(bar_index, eventLevel, "ChoCH ↑", color=color.new(color.green, 70), style=label.style_label_up, textcolor=color.white, size=size.small)

if chochBearish and show_choch and trendMethod == "Market Structure"
    line.new(eventBar, eventLevel, bar_index, eventLevel, color=color.red, width=2, style=line.style_solid)
    label.new(bar_index, eventLevel, "ChoCH ↓", color=color.new(color.red, 70), style=label.style_label_down, textcolor=color.white, size=size.small)

// ==================== BOS VISUALIZATION ====================
if bosBullish and show_bos and trendMethod == "Market Structure"
    line.new(eventBar, eventLevel, bar_index, eventLevel, color=color.teal, width=1, style=line.style_dashed)
    label.new(bar_index, eventLevel, "BOS ↑", color=color.new(color.teal, 70), style=label.style_label_down, textcolor=color.white, size=size.tiny)

if bosBearish and show_bos and trendMethod == "Market Structure"
    line.new(eventBar, eventLevel, bar_index, eventLevel, color=color.orange, width=1, style=line.style_dashed)
    label.new(bar_index, eventLevel, "BOS ↓", color=color.new(color.orange, 70), style=label.style_label_up, textcolor=color.white, size=size.tiny)

// ==================== NO WICK CANDLE DETECTION ====================
bullishNoBottomWick = open == low and close > open
bearishNoTopWick = open == high and close < open

// CRITICAL: Only allow trades in the correct direction based on CURRENT structure
// After ChoCH Bullish → ONLY LONG
// After ChoCH Bearish → ONLY SHORT
isBullishNoWick = bullishNoBottomWick and isBullishStructure
isBearishNoWick = bearishNoTopWick and isBearishStructure

// ==================== COMPENSATION LINES ====================
if (bullishNoBottomWick or bearishNoTopWick) and show_compensation
    compColor = color.rgb(255, 174, 53)
    line.new(bar_index, open, bar_index + compensationBars, open, color=compColor, width=1, style=line.style_solid)
    if show_compensation_label
        label.new(bar_index + compensationBars + 1, open, "Compensation", style=label.style_label_left, color=compColor, textcolor=color.white, size=size.tiny)

// ==================== ATR ====================
atr = ta.atr(14)

// Session check with timezone
isInSession = useSession ? not na(time(timeframe.period, tradingSession, sessionTimezone)) : true

// ==================== STRATEGY VARIABLES ====================
var float longEntryPrice = na
var float longStopLoss = na
var float longTakeProfit = na
var int longOrderBars = 0
var bool longPending = false

var float shortEntryPrice = na
var float shortStopLoss = na
var float shortTakeProfit = na
var int shortOrderBars = 0
var bool shortPending = false

var float signalAtr = na
var box entryBox = na
var box slBox = na

var float activeSL = na
var float activeTP = na
var bool inLong = false
var bool inShort = false

// ==================== CANCEL OPPOSITE ORDERS ON STRUCTURE CHANGE ====================
// If structure changes to bullish, cancel any pending short orders
if chochBullish and shortPending
    strategy.cancel("Short")
    shortEntryPrice := na
    shortStopLoss := na
    shortTakeProfit := na
    shortOrderBars := 0
    shortPending := false
    if not na(entryBox)
        box.delete(entryBox)
        entryBox := na
    if not na(slBox)
        box.delete(slBox)
        slBox := na

// If structure changes to bearish, cancel any pending long orders
if chochBearish and longPending
    strategy.cancel("Long")
    longEntryPrice := na
    longStopLoss := na
    longTakeProfit := na
    longOrderBars := 0
    longPending := false
    if not na(entryBox)
        box.delete(entryBox)
        entryBox := na
    if not na(slBox)
        box.delete(slBox)
        slBox := na

// ==================== LONG SETUP (ONLY IN BULLISH STRUCTURE) ====================
if isBullishNoWick and isInSession and strategy.position_size == 0 and not longPending and not shortPending and isBullishStructure
    if not na(entryBox)
        box.delete(entryBox)
    if not na(slBox)
        box.delete(slBox)
    
    longEntryPrice := open
    signalAtr := atr
    longStopLoss := longEntryPrice - (signalAtr * atrMultiplier)
    longTakeProfit := longEntryPrice + (signalAtr * atrMultiplier * tpMultiplier)
    longOrderBars := 0
    longPending := true
    
    if showZones
        entryBox := box.new(bar_index, close, bar_index + cancelAfter, longEntryPrice, border_color=color.green, bgcolor=color.new(color.green, zoneTransparency), border_width=1)
        slBox := box.new(bar_index, longEntryPrice, bar_index + cancelAfter, longStopLoss, border_color=color.red, bgcolor=color.new(color.red, zoneTransparency), border_width=1)
    
    strategy.entry("Long", strategy.long, limit=longEntryPrice, qty=contracts)

// ==================== SHORT SETUP (ONLY IN BEARISH STRUCTURE) ====================
if isBearishNoWick and isInSession and strategy.position_size == 0 and not shortPending and not longPending and isBearishStructure
    if not na(entryBox)
        box.delete(entryBox)
    if not na(slBox)
        box.delete(slBox)
    
    shortEntryPrice := open
    signalAtr := atr
    shortStopLoss := shortEntryPrice + (signalAtr * atrMultiplier)
    shortTakeProfit := shortEntryPrice - (signalAtr * atrMultiplier * tpMultiplier)
    shortOrderBars := 0
    shortPending := true
    
    if showZones
        entryBox := box.new(bar_index, shortEntryPrice, bar_index + cancelAfter, close, border_color=color.green, bgcolor=color.new(color.green, zoneTransparency), border_width=1)
        slBox := box.new(bar_index, shortStopLoss, bar_index + cancelAfter, shortEntryPrice, border_color=color.red, bgcolor=color.new(color.red, zoneTransparency), border_width=1)
    
    strategy.entry("Short", strategy.short, limit=shortEntryPrice, qty=contracts)

// ==================== POSITION MANAGEMENT ====================
if strategy.position_size > 0 and not inLong
    inLong := true
    inShort := false
    longPending := false
    activeSL := strategy.position_avg_price - (signalAtr * atrMultiplier)
    activeTP := strategy.position_avg_price + (signalAtr * atrMultiplier * tpMultiplier)
    strategy.exit("Long Exit", "Long", stop=activeSL, limit=activeTP)
    if not na(entryBox)
        box.delete(entryBox)
        entryBox := na
    if not na(slBox)
        box.delete(slBox)
        slBox := na

if strategy.position_size < 0 and not inShort
    inShort := true
    inLong := false
    shortPending := false
    activeSL := strategy.position_avg_price + (signalAtr * atrMultiplier)
    activeTP := strategy.position_avg_price - (signalAtr * atrMultiplier * tpMultiplier)
    strategy.exit("Short Exit", "Short", stop=activeSL, limit=activeTP)
    if not na(entryBox)
        box.delete(entryBox)
        entryBox := na
    if not na(slBox)
        box.delete(slBox)
        slBox := na

if strategy.position_size == 0
    if inLong or inShort
        activeSL := na
        activeTP := na
        inLong := false
        inShort := false
        longEntryPrice := na
        shortEntryPrice := na

// ==================== ORDER MANAGEMENT ====================
if longPending and strategy.position_size == 0
    longOrderBars := longOrderBars + 1
    if longOrderBars >= cancelAfter
        strategy.cancel("Long")
        longEntryPrice := na
        longStopLoss := na
        longTakeProfit := na
        longOrderBars := 0
        longPending := false
        if not na(entryBox)
            box.delete(entryBox)
            entryBox := na
        if not na(slBox)
            box.delete(slBox)
            slBox := na

if shortPending and strategy.position_size == 0
    shortOrderBars := shortOrderBars + 1
    if shortOrderBars >= cancelAfter
        strategy.cancel("Short")
        shortEntryPrice := na
        shortStopLoss := na
        shortTakeProfit := na
        shortOrderBars := 0
        shortPending := false
        if not na(entryBox)
            box.delete(entryBox)
            entryBox := na
        if not na(slBox)
            box.delete(slBox)
            slBox := na

// ==================== VISUALIZATION ====================
bgcolor(isBullishStructure ? color.new(color.green, 95) : isBearishStructure ? color.new(color.red, 95) : na)
bgcolor(useSession and isInSession ? color.new(color.blue, 95) : na, title="Session Highlight")

plot(trendMethod == "EMA" ? ema : na, "EMA", color=color.orange, linewidth=2)

plot(inLong or inShort ? activeSL : na, "Stop Loss", color=color.red, style=plot.style_linebr, linewidth=2)
plot(inLong or inShort ? activeTP : na, "Take Profit", color=color.green, style=plot.style_linebr, linewidth=2)
plot(inLong or inShort ? strategy.position_avg_price : na, "Entry", color=color.blue, style=plot.style_linebr, linewidth=1)

plotshape(bullishNoBottomWick, "Bullish No Wick (All)", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(bearishNoTopWick, "Bearish No Wick (All)", shape.triangledown, location.abovebar, color.red, size=size.small)

plotshape(isBullishNoWick and isInSession and strategy.position_size == 0 and not longPending and not shortPending, "Long Signal", shape.circle, location.belowbar, color.lime, size=size.tiny, offset=-1)
plotshape(isBearishNoWick and isInSession and strategy.position_size == 0 and not shortPending and not longPending, "Short Signal", shape.circle, location.abovebar, color.fuchsia, size=size.tiny, offset=-1)

// ==================== INFO TABLE ====================
var table infoTable = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 80))
if barstate.islast
    table.cell(infoTable, 0, 0, "Filter Method", text_color=color.white)
    table.cell(infoTable, 1, 0, trendMethod, text_color=color.yellow)
    table.cell(infoTable, 0, 1, "Structure", text_color=color.white)
    table.cell(infoTable, 1, 1, marketStructure == 1 ? "BULLISH ↑" : marketStructure == -1 ? "BEARISH ↓" : "NEUTRAL", text_color=marketStructure == 1 ? color.green : marketStructure == -1 ? color.red : color.gray)
    table.cell(infoTable, 0, 2, "Trade Direction", text_color=color.white)
    table.cell(infoTable, 1, 2, marketStructure == 1 ? "LONG ONLY" : marketStructure == -1 ? "SHORT ONLY" : "NONE", text_color=marketStructure == 1 ? color.green : marketStructure == -1 ? color.red : color.gray)
    table.cell(infoTable, 0, 3, "Session", text_color=color.white)
    table.cell(infoTable, 1, 3, useSession ? (isInSession ? "ACTIVE" : "INACTIVE") : "OFF", text_color=useSession ? (isInSession ? color.green : color.red) : color.gray)
    table.cell(infoTable, 0, 4, "Last High", text_color=color.white)
    table.cell(infoTable, 1, 4, trendMethod == "Market Structure" ? ((isHigherHigh ? "HH " : "LH ") + str.tostring(h0, "#.##")) : "-", text_color=isHigherHigh ? color.green : color.red)
    table.cell(infoTable, 0, 5, "Last Low", text_color=color.white)
    table.cell(infoTable, 1, 5, trendMethod == "Market Structure" ? ((isHigherLow ? "HL " : "LL ") + str.tostring(l0, "#.##")) : "-", text_color=isHigherLow ? color.green : color.red)
    table.cell(infoTable, 0, 6, "No Wick", text_color=color.white)
    table.cell(infoTable, 1, 6, bullishNoBottomWick ? "BULLISH ▲" : bearishNoTopWick ? "BEARISH ▼" : "-", text_color=bullishNoBottomWick ? color.green : bearishNoTopWick ? color.red : color.gray)
    table.cell(infoTable, 0, 7, "Position", text_color=color.white)
    table.cell(infoTable, 1, 7, inLong ? "LONG" : inShort ? "SHORT" : "FLAT", text_color=inLong ? color.green : inShort ? color.red : color.gray)
    table.cell(infoTable, 0, 8, "Stop Loss", text_color=color.white)
    table.cell(infoTable, 1, 8, not na(activeSL) ? str.tostring(activeSL, "#.##") : "-", text_color=color.red)
    table.cell(infoTable, 0, 9, "Take Profit", text_color=color.white)
    table.cell(infoTable, 1, 9, not na(activeTP) ? str.tostring(activeTP, "#.##") : "-", text_color=color.green)

// ==================== ALERTS ====================
alertcondition(chochBullish, "Bullish ChoCH", "Bullish Change of Character - Now LONG ONLY!")
alertcondition(chochBearish, "Bearish ChoCH", "Bearish Change of Character - Now SHORT ONLY!")
alertcondition(bosBullish, "Bullish BOS", "Bullish Break of Structure!")
alertcondition(bosBearish, "Bearish BOS", "Bearish Break of Structure!")
alertcondition(isBullishNoWick, "Long Signal", "Bullish No Wick in Bullish Structure - LONG!")
alertcondition(isBearishNoWick, "Short Signal", "Bearish No Wick in Bearish Structure - SHORT!")
