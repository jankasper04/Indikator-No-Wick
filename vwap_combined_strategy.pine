// VWAP Combined Strategy - Mean Reversion with POC Confirmation
// Entry: Candle closes outside VWAP band + POC inside band
// SL: 1x ATR | TP: 1.5 RR
//@version=6

strategy(title="VWAP Combined Strategy", shorttitle="VWAP Strategy", overlay=true, 
  max_bars_back=1000,
  initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100,
  commission_type=strategy.commission.percent, commission_value=0.04,
  pyramiding=0)

// ============================================
// STRATEGY SETTINGS
// ============================================
STRATEGY_GROUP = "Strategy Settings"
atrLength = input.int(14, "ATR Period", minval=1, group=STRATEGY_GROUP)
atrMultSL = input.float(1.0, "ATR Multiplier for SL", minval=0.1, step=0.1, group=STRATEGY_GROUP)
riskReward = input.float(1.5, "Risk-Reward Ratio", minval=0.5, step=0.1, group=STRATEGY_GROUP)

// ============================================
// VWAP SETTINGS
// ============================================
VWAP_GROUP = "VWAP Settings"
var anchor = input.string(defval="Session", title="Anchor Period",
     options=["Session", "Week", "Month", "Quarter", "Year"], group=VWAP_GROUP)
bandMult = input.float(1.0, title="Band Multiplier", group=VWAP_GROUP, step=0.5, minval=0.1)

// ============================================
// VOLUME PROFILE SETTINGS
// ============================================
VP_GROUP = "Volume Profile"
vpLength = input.int(300, 'Lookback', minval=1, maxval=1000, group=VP_GROUP)
vpRow = input.int(26, 'Row Size', minval=1, maxval=500, group=VP_GROUP)

// ============================================
// VWAP CALCULATIONS
// ============================================
isNewPeriod = switch anchor
    "Session"   => timeframe.change("D")
    "Week"      => timeframe.change("W")
    "Month"     => timeframe.change("M")
    "Quarter"   => timeframe.change("3M")
    "Year"      => timeframe.change("12M")
    => false

if na(hlc3[1])
    isNewPeriod := true

[vwapValue, stdevUpper, _] = ta.vwap(hlc3, isNewPeriod, 1)
stdevAbs = stdevUpper - vwapValue
upperBand = vwapValue + stdevAbs * bandMult
lowerBand = vwapValue - stdevAbs * bandMult

// ============================================
// ATR CALCULATION
// ============================================
atrValue = ta.atr(atrLength)

// ============================================
// VOLUME PROFILE - POC CALCULATION
// ============================================
var float pocValue = 0.0

vpHighest = ta.highest(high, vpLength)
vpLowest = ta.lowest(low, vpLength)

if barstate.isconfirmed
    float[] levels = array.new_float(vpRow + 1)
    float[] sumv = array.new_float(vpRow, 0.0)
    
    priceRange = vpHighest - vpLowest
    for i = 0 to vpRow
        array.set(levels, i, vpLowest + i / vpRow * priceRange)
    
    for j = 0 to vpRow - 1
        lvlLow = array.get(levels, j)
        lvlHigh = array.get(levels, j + 1)
        sum = 0.0
        for k = 0 to vpLength - 1
            if high[k] > lvlLow and low[k] < lvlHigh
                sum += volume[k]
        array.set(sumv, j, sum)
    
    maxVol = array.max(sumv)
    maxVolIdx = array.indexof(sumv, maxVol)
    
    if maxVolIdx >= 0
        pocValue := math.avg(array.get(levels, maxVolIdx), array.get(levels, maxVolIdx + 1))

// ============================================
// STRATEGY LOGIC
// ============================================
// Check if POC is inside VWAP bands
pocInsideBands = pocValue <= upperBand and pocValue >= lowerBand

// Check if close is outside VWAP bands
closeAboveUpperBand = close > upperBand
closeBelowLowerBand = close < lowerBand

// Entry conditions
longCondition = closeBelowLowerBand and pocInsideBands and strategy.position_size == 0
shortCondition = closeAboveUpperBand and pocInsideBands and strategy.position_size == 0

// Calculate SL and TP levels
slDistance = atrValue * atrMultSL
tpDistance = slDistance * riskReward

// Execute trades
if longCondition
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=close - slDistance, limit=close + tpDistance)

if shortCondition
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=close + slDistance, limit=close - tpDistance)

// ============================================
// PLOTS
// ============================================
plot(vwapValue, title="VWAP", color=#2962FF)
plot(upperBand, title="Upper Band", color=color.green)
plot(lowerBand, title="Lower Band", color=color.green)
plot(pocValue, title="POC", color=#ff0000, linewidth=2)

// Entry Signals
plotshape(longCondition, title="Long", location=location.belowbar, color=color.lime, style=shape.triangleup, size=size.small)
plotshape(shortCondition, title="Short", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)

// ============================================
// ALERTS
// ============================================
alertcondition(longCondition, title="Long Entry", message="VWAP Strategy: Long Entry")
alertcondition(shortCondition, title="Short Entry", message="VWAP Strategy: Short Entry")
